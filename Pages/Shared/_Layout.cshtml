@using Microsoft.AspNetCore.Http
@{
    var username = Context.Session.GetString("Username");
    var role = Context.Session.GetString("Role");
    var fullname = Context.Session.GetString("Fullname");
    var isLoggedIn = !string.IsNullOrEmpty(username);
    var avatarLetter = (!string.IsNullOrEmpty(fullname)) ? fullname.Substring(0, 1).ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống quản lý trung tâm</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
            /* ════════════════════════════════════
                                                                               DESIGN TOKENS
                                                                            ════════════════════════════════════ */
            :root {
                --c-primary: #e8590c;
                --c-secondary: #f59f00;
                --c-gradient: linear-gradient(135deg,#e8590c 0%,#f59f00 100%);
                --c-glow: rgba(232,89,12,.20);
                --sb-bg: #0f1117;
                --sb-border: rgba(255,255,255,.07);
                --sb-muted: rgba(255,255,255,.40);
                --sb-hover: rgba(255,255,255,.05);
                --sb-width: 228px;
                --hd-bg: #ffffff;
                --hd-border: #eef0f6;
                --hd-h: 58px;
                --bg-page: #eef1f8;
                --bg-card: #ffffff;
                --text-1: #181b27;
                --text-2: #5a6277;
                --text-3: #9aa0b4;
                --border: #e4e8f2;
                --r-sm: 8px;
                --r-md: 12px;
                --r-lg: 16px;
                --r-xl: 24px;
                --sh-xs: 0 1px 3px rgba(0,0,0,.05);
                --sh-sm: 0 2px 8px rgba(0,0,0,.06),0 1px 3px rgba(0,0,0,.04);
                --sh-md: 0 4px 20px rgba(0,0,0,.09),0 2px 8px rgba(0,0,0,.04);
                --sh-lg: 0 20px 60px rgba(0,0,0,.14),0 6px 20px rgba(0,0,0,.07);
                --ease: cubic-bezier(.4,0,.2,1);
            }

            /* ════════════════════════════════════
                                                                               BASE
                                                                            ════════════════════════════════════ */
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            /* Prevent black/transparent areas during full-page screenshots */
            html {
                background: var(--bg-page);
            }

            html, body {
                height: 100%;
                min-height: 100%;
                font-family: 'Plus Jakarta Sans',system-ui,sans-serif;
                background: var(--bg-page);
                color: var(--text-1);
                font-size: 14px;
                line-height: 1.5;
                -webkit-font-smoothing: antialiased;
            }

            /* ════════════════════════════════════
                                                                               APP SHELL
                                                                            ════════════════════════════════════ */
            .app-shell {
                display: flex;
                height: 100vh;
                overflow: hidden; /* scroll xảy ra bên trong, không phải body */
            }


            /* ════════════════════════════════════
                                                                               SIDEBAR
                                                                               Desktop: sticky flex column, scroll nội dung bên trong
                                                                               Mobile:  position:fixed drawer via media query
                                                                            ════════════════════════════════════ */
            .sidebar {
                width: var(--sb-width);
                min-width: var(--sb-width);
                height: 100vh;
                position: sticky;
                top: 0;
                flex-shrink: 0;
                background: var(--sb-bg);
                display: flex;
                flex-direction: column;
                overflow: hidden;
                z-index: 350;
                transition: width .35s var(--ease), min-width .35s var(--ease);
            }

            /* Brand */
            .sb-brand {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 15px 12px 11px;
                min-height: 98px;
                text-decoration: none !important;
                flex-shrink: 0;
                user-select: none;
            }

            .sb-brand-logo-wrap {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .sb-brand-logo {
                display: block;
                width: auto;
                max-width: 162px;
                max-height: 78px;
                object-fit: contain;
                filter: drop-shadow(0 4px 14px rgba(232,89,12,.12));
            }

            .sb-brand-icon {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: var(--c-gradient);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 16px;
                flex-shrink: 0;
                box-shadow: 0 4px 14px var(--c-glow);
            }

            .sb-brand-name {
                display: block;
                font-size: 1rem;
                font-weight: 800;
                color: #fff;
                line-height: 1.1;
                white-space: nowrap;
                letter-spacing: .4px;
            }

            .sb-brand-tagline {
                display: block;
                font-size: .57rem;
                color: var(--sb-muted);
                white-space: nowrap;
                margin-top: 2px;
                letter-spacing: .3px;
            }

            .sb-divider {
                height: 1px;
                background: var(--sb-border);
                margin: 0 14px 6px;
                flex-shrink: 0;
            }

            /* Nav scroll area — fills remaining space */
            .sb-nav {
                flex: 1;
                overflow-y: auto;
                overflow-x: hidden;
                padding: 0 8px 8px;
                scrollbar-width: none;
            }

                .sb-nav::-webkit-scrollbar {
                    display: none
                }

            /* Section labels */
            .sb-section {
                font-size: .58rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                color: rgba(255,255,255,.2);
                padding: 9px 10px 2px;
                white-space: nowrap;
                overflow: hidden;
            }

            /* Nav links */
            .sb-link {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 5px 11px;
                min-height: 34px;
                border-radius: var(--r-sm);
                color: var(--sb-muted) !important;
                text-decoration: none !important;
                font-size: .82rem;
                font-weight: 500;
                transition: all .15s var(--ease);
                position: relative;
                white-space: nowrap;
                overflow: hidden;
                margin-bottom: 0;
            }

                .sb-link i {
                    width: 17px;
                    text-align: center;
                    font-size: 13px;
                    flex-shrink: 0;
                    transition: color .15s
                }

                .sb-link span {
                    overflow: hidden;
                    text-overflow: ellipsis
                }

                .sb-link:hover {
                    background: var(--sb-hover);
                    color: rgba(255,255,255,.88) !important
                }

                    .sb-link:hover i {
                        color: var(--c-secondary)
                    }

                .sb-link.active {
                    background: linear-gradient(90deg,rgba(232,89,12,.22) 0%,rgba(245,159,0,.07) 100%);
                    color: #fff !important;
                    font-weight: 600;
                }

                    .sb-link.active i {
                        color: var(--c-secondary)
                    }

                    .sb-link.active::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 18%;
                        height: 64%;
                        width: 3px;
                        border-radius: 0 3px 3px 0;
                        background: var(--c-gradient);
                    }

            /* Collapsed desktop */
            .sidebar.sb-hidden {
                width: 0;
                min-width: 0
            }

            /* ════════════════════════════════════
                                                                               MOBILE OVERLAY (backdrop)
                                                                               z-index ladder:
                                                                                 header      = 400  (always on top, clickable)
                                                                                 sidebar     = 350  (drawer, above overlay)
                                                                                 overlay     = 300  (dims content below sidebar)
                                                                                 dropdown    = 9999 (fixed, above everything)
                                                                            ════════════════════════════════════ */
            .sb-overlay {
                display: none;
                position: fixed;
                inset: 0;
                /* top starts at header height so it does NOT cover the header */
                top: var(--hd-h);
                z-index: 300;
                background: rgba(0,0,0,.45);
                backdrop-filter: blur(2px);
                opacity: 0;
                transition: opacity .3s var(--ease);
                pointer-events: none;
            }

                .sb-overlay.active {
                    opacity: 1;
                    pointer-events: all;
                }

            /* ════════════════════════════════════
                                                                               MAIN AREA
                                                                            ════════════════════════════════════ */
            .main-area {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
                overflow-y: auto; /* scroll xảy ra ở đây, không phải body */
                overflow-x: hidden;
            }

            /* ════════════════════════════════════
                                                                               HEADER
                                                                               z-index:400 — always above sidebar overlay
                                                                            ════════════════════════════════════ */
            .app-header {
                height: var(--hd-h);
                min-height: var(--hd-h);
                background: var(--hd-bg);
                border-bottom: 1px solid var(--hd-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 12px 0 10px;
                flex-shrink: 0;
                position: relative;
                z-index: 400; /* above overlay (300) and sidebar (350) */
                box-shadow: var(--sh-xs);
                min-width: 0;
            }

            /* Left: toggle + title — toggle must NEVER be clipped */
            .hd-left {
                display: flex;
                align-items: center;
                gap: 8px;
                /* flex:1 lets title shrink; toggle stays fixed via flex-shrink:0 */
                flex: 1;
                min-width: 0;
                /* NO overflow:hidden here — that was clipping the toggle button */
            }

            /* Hamburger toggle — always visible, never shrinks */
            .hd-toggle {
                width: 38px;
                height: 38px;
                border: none;
                background: transparent;
                border-radius: var(--r-sm);
                color: var(--text-2);
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 17px;
                transition: background .15s,color .15s;
                flex-shrink: 0; /* critical: never compress */
                flex-grow: 0;
            }

                .hd-toggle:hover {
                    background: var(--bg-page);
                    color: var(--c-primary)
                }

            /* Page title — allowed to shrink + truncate, but toggle is safe */
            .hd-page-title {
                font-size: .88rem;
                font-weight: 700;
                color: var(--text-1);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                min-width: 0;
                flex: 1;
            }

            /* Right cluster — never shrinks, never pushed off screen */
            .hd-right {
                display: flex;
                align-items: center;
                gap: 6px;
                flex-shrink: 0;
                flex-grow: 0;
                margin-left: 8px; /* breathing room from title */
            }

            /* ── USER BUTTON ── */
            .hd-user-btn {
                display: flex;
                align-items: center;
                gap: 8px;
                /* On wide screens: pill with text. On narrow: avatar-only circle */
                padding: 4px 10px 4px 4px;
                background: #fff;
                border: 1.5px solid var(--border);
                border-radius: 50px;
                cursor: pointer;
                text-decoration: none !important;
                color: var(--text-1) !important;
                transition: border-color .15s, box-shadow .15s;
                flex-shrink: 0; /* never compress */
                white-space: nowrap;
            }

                .hd-user-btn:hover {
                    border-color: var(--c-primary);
                    box-shadow: 0 0 0 3px var(--c-glow)
                }

                .hd-user-btn::after {
                    display: none !important
                }

            .hd-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: var(--c-gradient);
                color: #fff;
                font-weight: 800;
                font-size: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                box-shadow: 0 2px 8px var(--c-glow);
            }

            .hd-user-name {
                display: block;
                font-size: .8rem;
                font-weight: 700;
                color: var(--text-1);
                white-space: nowrap;
                max-width: 130px;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .hd-user-role {
                display: block;
                font-size: .62rem;
                font-weight: 700;
                color: var(--c-primary);
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .hd-caret {
                font-size: 9px;
                color: var(--text-3);
                transition: transform .2s
            }

            .hd-user-btn[aria-expanded="true"] .hd-caret {
                transform: rotate(180deg)
            }

            /* ── DROPDOWN MENU ──
                                                                               Key trick: position:fixed so it always renders below the header,
                                                                               never jumps or clips inside an overflow:hidden ancestor.
                                                                               Top is set via JS to exactly header height.               */
            .user-dd-menu {
                display: none; /* hidden by default */
                position: fixed; /* NOT absolute — avoids overflow clipping */
                right: 16px;
                top: var(--hd-h); /* always flush below header */
                min-width: 215px;
                background: #fff;
                border: 1px solid var(--border);
                border-radius: var(--r-lg);
                box-shadow: var(--sh-lg);
                padding: 6px;
                list-style: none;
                z-index: 9999;
                transform-origin: top right;
            }

                .user-dd-menu.show {
                    display: block;
                    animation: ddSlide .22s var(--ease) forwards;
                }
            /* Smooth drop — starts slightly small and above, lands in place */
            @@keyframes ddSlide {
                from {
                    opacity: 0;
                    transform: translateY(-6px) scale(.97)
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1)
                }
            }

            /* User card inside dropdown */
            .dd-user-card {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 12px 12px;
                border-bottom: 1px solid var(--border);
                margin-bottom: 4px;
            }

            .dd-avatar-lg {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--c-gradient);
                color: #fff;
                font-weight: 800;
                font-size: 15px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                box-shadow: 0 2px 10px var(--c-glow);
            }

            .dd-name {
                font-size: .88rem;
                font-weight: 700;
                color: var(--text-1)
            }

            .dd-role {
                font-size: .65rem;
                font-weight: 700;
                color: var(--c-primary);
                text-transform: uppercase;
                letter-spacing: .5px;
                margin-top: 1px
            }

            /* Items */
            .dd-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 12px;
                border-radius: var(--r-sm);
                font-size: .83rem;
                font-weight: 500;
                color: var(--text-1);
                text-decoration: none;
                transition: background .12s,color .12s;
                cursor: pointer;
                list-style: none;
            }

                .dd-item i {
                    width: 18px;
                    text-align: center;
                    font-size: 13px;
                    color: var(--text-3);
                    transition: color .12s
                }

                .dd-item:hover {
                    background: #fff5eb;
                    color: var(--c-primary)
                }

                    .dd-item:hover i {
                        color: var(--c-primary)
                    }

                .dd-item.dd-logout {
                    color: #e03131
                }

                    .dd-item.dd-logout i {
                        color: #e03131
                    }

                    .dd-item.dd-logout:hover {
                        background: #fff0f0
                    }

            .dd-divider {
                height: 1px;
                background: var(--border);
                margin: 5px 8px
            }

            /* ════════════════════════════════════
                                                                               PAGE CONTENT
                                                                            ════════════════════════════════════ */
            .page-content {
                flex: 1;
                /* overflow-y chuyển về body — GoFullPage mới scroll được toàn trang */
                overflow-x: hidden;
                padding: 28px;
                background: var(--bg-page);
            }

            /* ════════════════════════════════════
                                                                               PAGE HEADER  (top of each view)
                                                                            ════════════════════════════════════ */
            .page-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 12px;
                margin-bottom: 24px;
                padding-bottom: 20px;
                border-bottom: 2px solid var(--border);
            }

            .page-heading {
                font-size: 1.5rem;
                font-weight: 800;
                color: var(--text-1);
                letter-spacing: -.4px;
                line-height: 1.2;
            }

                .page-heading span {
                    background: var(--c-gradient);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                }

            .page-subheading {
                font-size: .82rem;
                color: var(--text-2);
                margin-top: 4px
            }

            .page-actions {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap
            }

            /* ════════════════════════════════════
                                                                               STAT GRID
                                                                            ════════════════════════════════════ */
            .stat-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill,minmax(190px,1fr));
                gap: 16px;
                margin-bottom: 28px;
            }

            .stat-card {
                background: var(--bg-card);
                border-radius: var(--r-lg);
                padding: 20px 20px 18px;
                display: flex;
                align-items: center;
                gap: 14px;
                box-shadow: var(--sh-sm);
                border: 1px solid var(--border);
                transition: box-shadow .2s,transform .2s;
                text-decoration: none !important;
                color: inherit !important;
            }

                .stat-card:hover {
                    box-shadow: var(--sh-md);
                    transform: translateY(-3px)
                }

            .stat-icon {
                width: 48px;
                height: 48px;
                border-radius: var(--r-md);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
                flex-shrink: 0;
            }

                .stat-icon.orange {
                    background: rgba(232,89,12,.12);
                    color: #e8590c
                }

                .stat-icon.amber {
                    background: rgba(245,159,0,.12);
                    color: #f59f00
                }

                .stat-icon.blue {
                    background: rgba(59,130,246,.12);
                    color: #3b82f6
                }

                .stat-icon.green {
                    background: rgba(16,185,129,.12);
                    color: #10b981
                }

                .stat-icon.purple {
                    background: rgba(139,92,246,.12);
                    color: #8b5cf6
                }

                .stat-icon.rose {
                    background: rgba(244,63,94,.12);
                    color: #f43f5e
                }

            .stat-value {
                font-size: 1.6rem;
                font-weight: 800;
                color: var(--text-1);
                line-height: 1
            }

            .stat-label {
                font-size: .75rem;
                color: var(--text-2);
                margin-top: 4px;
                font-weight: 500
            }

            /* ════════════════════════════════════
                                                                               CONTENT CARD
                                                                            ════════════════════════════════════ */
            .content-card {
                background: var(--bg-card);
                border-radius: var(--r-lg);
                border: 1px solid var(--border);
                box-shadow: var(--sh-sm);
                overflow: hidden;
                margin-bottom: 20px;
            }

            .content-card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 10px;
                padding: 16px 20px;
                border-bottom: 1px solid var(--border);
                background: linear-gradient(to right,#fafbff,#ffffff);
            }

            .content-card-title {
                font-size: .95rem;
                font-weight: 700;
                color: var(--text-1);
                display: flex;
                align-items: center;
                gap: 9px;
            }

                .content-card-title .ct-icon {
                    width: 28px;
                    height: 28px;
                    border-radius: 7px;
                    background: rgba(232,89,12,.1);
                    color: var(--c-primary);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 13px;
                }

            .content-card-actions {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap
            }

            .content-card-body {
                padding: 20px
            }

                .content-card-body.no-pad {
                    padding: 0
                }

            .content-card-footer {
                padding: 14px 20px;
                border-top: 1px solid var(--border);
                background: #f9fafd;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                flex-wrap: wrap;
            }

            /* ════════════════════════════════════
                                                                               TABLE
                                                                            ════════════════════════════════════ */
            .tbl-wrap {
                overflow-x: auto
            }

            .tbl {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0
            }

                .tbl thead th {
                    padding: 11px 16px;
                    font-size: .72rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: .7px;
                    color: var(--text-2);
                    background: #f4f6fc;
                    border-bottom: 2px solid var(--border);
                    white-space: nowrap;
                }

                    .tbl thead th:first-child {
                        padding-left: 20px
                    }

                    .tbl thead th:last-child {
                        padding-right: 20px
                    }

                .tbl tbody td {
                    padding: 12px 16px;
                    font-size: .83rem;
                    color: var(--text-1);
                    border-bottom: 1px solid #f0f2f8;
                    vertical-align: middle;
                }

                    .tbl tbody td:first-child {
                        padding-left: 20px
                    }

                    .tbl tbody td:last-child {
                        padding-right: 20px
                    }

                .tbl tbody tr:last-child td {
                    border-bottom: none
                }

                .tbl tbody tr:hover td {
                    background: #f8faff
                }

            /* ════════════════════════════════════
                                                                               BADGE
                                                                            ════════════════════════════════════ */
            .bdg {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 3px 10px;
                border-radius: 50px;
                font-size: .7rem;
                font-weight: 600;
            }

                .bdg .dot {
                    width: 5px;
                    height: 5px;
                    border-radius: 50%
                }

                .bdg.success {
                    background: #ecfdf5;
                    color: #059669
                }

                    .bdg.success .dot {
                        background: #059669
                    }

                .bdg.warning {
                    background: #fffbeb;
                    color: #d97706
                }

                    .bdg.warning .dot {
                        background: #d97706
                    }

                .bdg.danger {
                    background: #fff1f2;
                    color: #e03131
                }

                    .bdg.danger .dot {
                        background: #e03131
                    }

                .bdg.info {
                    background: #eff6ff;
                    color: #3b82f6
                }

                    .bdg.info .dot {
                        background: #3b82f6
                    }

                .bdg.neutral {
                    background: #f3f4f6;
                    color: #6b7280
                }

                    .bdg.neutral .dot {
                        background: #9ca3af
                    }

            /* ════════════════════════════════════
                                                                               BUTTONS  — prominent & clear
                                                                            ════════════════════════════════════ */
            .btn-brand {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 9px 20px;
                border-radius: var(--r-sm);
                background: var(--c-gradient);
                color: #fff !important;
                font-weight: 700;
                font-size: .84rem;
                border: none;
                cursor: pointer;
                text-decoration: none !important;
                box-shadow: 0 4px 14px var(--c-glow);
                transition: filter .15s,box-shadow .15s,transform .15s;
                letter-spacing: .2px;
            }

                .btn-brand:hover {
                    filter: brightness(1.08);
                    box-shadow: 0 6px 20px rgba(232,89,12,.35);
                    transform: translateY(-1px)
                }

                .btn-brand:active {
                    transform: translateY(0);
                    filter: brightness(.97)
                }

            .btn-outline {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 8px 18px;
                border-radius: var(--r-sm);
                background: #fff;
                color: var(--text-2) !important;
                font-weight: 600;
                font-size: .84rem;
                border: 1.5px solid var(--border);
                cursor: pointer;
                text-decoration: none !important;
                transition: border-color .15s,color .15s,background .15s;
            }

                .btn-outline:hover {
                    border-color: var(--c-primary);
                    color: var(--c-primary) !important;
                    background: #fff9f5
                }

            .btn-ghost {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 7px 13px;
                border-radius: var(--r-sm);
                background: transparent;
                color: var(--text-2) !important;
                font-weight: 600;
                font-size: .82rem;
                border: none;
                cursor: pointer;
                text-decoration: none !important;
                transition: background .15s,color .15s;
            }

                .btn-ghost:hover {
                    background: var(--bg-page);
                    color: var(--text-1) !important
                }

            .btn-danger-soft {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 8px 16px;
                border-radius: var(--r-sm);
                background: #fff1f2;
                color: #e03131 !important;
                font-weight: 600;
                font-size: .84rem;
                border: 1.5px solid #fecdd3;
                cursor: pointer;
                text-decoration: none !important;
                transition: background .15s,border-color .15s;
            }

                .btn-danger-soft:hover {
                    background: #ffe4e6;
                    border-color: #e03131
                }

            /* Icon-only button */
            .btn-icon {
                width: 34px;
                height: 34px;
                border-radius: var(--r-sm);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1.5px solid var(--border);
                background: #fff;
                color: var(--text-2);
                cursor: pointer;
                font-size: 13px;
                text-decoration: none !important;
                transition: all .15s;
            }

                .btn-icon:hover {
                    border-color: var(--c-primary);
                    color: var(--c-primary);
                    background: #fff9f5
                }

                .btn-icon.danger:hover {
                    border-color: #e03131;
                    color: #e03131;
                    background: #fff0f0
                }

            /* ════════════════════════════════════
                                                                               SEARCH BAR
                                                                            ════════════════════════════════════ */
            .search-wrap {
                position: relative;
                display: inline-flex;
                align-items: center
            }

                .search-wrap i {
                    position: absolute;
                    left: 11px;
                    color: var(--text-3);
                    font-size: 13px;
                    pointer-events: none
                }

            .search-input {
                padding: 8px 13px 8px 34px;
                border: 1.5px solid var(--border);
                border-radius: var(--r-sm);
                background: #fff;
                color: var(--text-1);
                font-size: .83rem;
                font-family: inherit;
                outline: none;
                transition: border-color .15s,box-shadow .15s,width .25s var(--ease);
                width: 200px;
            }

                .search-input:focus {
                    border-color: var(--c-primary);
                    box-shadow: 0 0 0 3px var(--c-glow);
                    width: 250px;
                }

                .search-input::placeholder {
                    color: var(--text-3)
                }

            /* ════════════════════════════════════
                                                                               FORM
                                                                            ════════════════════════════════════ */
            .form-group {
                margin-bottom: 18px
            }

            .form-label-custom {
                display: block;
                font-size: .78rem;
                font-weight: 700;
                color: var(--text-2);
                margin-bottom: 6px;
                letter-spacing: .2px;
            }

            .form-control, .form-select {
                width: 100%;
                padding: 9px 13px;
                border: 1.5px solid var(--border);
                border-radius: var(--r-sm);
                background: #fff;
                color: var(--text-1);
                font-size: .85rem;
                font-family: inherit;
                transition: border-color .15s,box-shadow .15s;
                outline: none;
            }

                .form-control:focus, .form-select:focus {
                    border-color: var(--c-primary);
                    box-shadow: 0 0 0 3px var(--c-glow);
                }

            /* ════════════════════════════════════
                                                                               FILTER BAR
                                                                            ════════════════════════════════════ */
            .filter-bar {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 10px;
                padding: 12px 20px;
                border-bottom: 1px solid var(--border);
                background: #f9fafd;
            }

                .filter-bar .form-select {
                    width: auto;
                    min-width: 130px;
                    padding: 7px 13px
                }

            /* ════════════════════════════════════
                                                                               EMPTY STATE
                                                                            ════════════════════════════════════ */
            .empty-state {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 64px 20px;
                text-align: center;
            }

            .empty-icon {
                width: 68px;
                height: 68px;
                border-radius: 50%;
                background: var(--bg-page);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                color: var(--text-3);
                margin-bottom: 16px;
            }

            .empty-title {
                font-size: 1rem;
                font-weight: 700;
                color: var(--text-1);
                margin-bottom: 6px
            }

            .empty-desc {
                font-size: .82rem;
                color: var(--text-2);
                max-width: 300px
            }

            /* ════════════════════════════════════
                                                                               ALERT STRIP
                                                                            ════════════════════════════════════ */
            .alert-strip {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 16px;
                border-radius: var(--r-md);
                font-size: .83rem;
                font-weight: 500;
                margin-bottom: 18px;
            }

                .alert-strip i {
                    font-size: 15px;
                    flex-shrink: 0
                }

                .alert-strip.success {
                    background: #ecfdf5;
                    color: #065f46;
                    border: 1px solid #a7f3d0
                }

                .alert-strip.warning {
                    background: #fffbeb;
                    color: #92400e;
                    border: 1px solid #fde68a
                }

                .alert-strip.danger {
                    background: #fff1f2;
                    color: #9f1239;
                    border: 1px solid #fecdd3
                }

                .alert-strip.info {
                    background: #eff6ff;
                    color: #1e40af;
                    border: 1px solid #bfdbfe
                }

            /* ════════════════════════════════════
                                                                               PAGER
                                                                            ════════════════════════════════════ */
            .pager {
                display: flex;
                align-items: center;
                gap: 4px
            }

            .pager-btn {
                min-width: 32px;
                height: 32px;
                padding: 0 8px;
                border-radius: var(--r-sm);
                border: 1.5px solid var(--border);
                background: #fff;
                color: var(--text-2);
                font-size: .8rem;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all .15s;
                text-decoration: none !important;
            }

                .pager-btn:hover {
                    border-color: var(--c-primary);
                    color: var(--c-primary)
                }

                .pager-btn.active {
                    background: var(--c-primary);
                    border-color: var(--c-primary);
                    color: #fff !important
                }

            /* ════════════════════════════════════
                                                                               MODAL
                                                                            ════════════════════════════════════ */
            .modal-content {
                border: none !important;
                border-radius: var(--r-xl) !important;
                box-shadow: var(--sh-lg) !important;
                overflow: hidden
            }

            .modal-header {
                background: #f7f8fc;
                border-bottom: 1px solid var(--border) !important;
                padding: 18px 24px !important
            }

            .modal-title {
                font-size: 1rem !important;
                font-weight: 700 !important
            }

            .modal-body {
                padding: 24px !important
            }

            .modal-footer {
                border-top: 1px solid var(--border) !important;
                padding: 14px 24px !important;
                gap: 8px
            }

            /* ════════════════════════════════════
                                                                               UTILITY
                                                                            ════════════════════════════════════ */
            .text-brand {
                color: var(--c-primary) !important
            }

            .fw-700 {
                font-weight: 700 !important
            }

            .fw-800 {
                font-weight: 800 !important
            }

            .truncate {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap
            }

            .row-divider {
                border: none;
                border-top: 1px solid var(--border);
                margin: 16px 0
            }

            /* ════════════════════════════════════
                                                                               RESPONSIVE — MOBILE
                                                                            ════════════════════════════════════ */

            /* ── Tablet & phones (≤768px) ── */
            @@media (max-width:768px) {
                .app-shell {
                    height: 100vh;
                    overflow: hidden;
                }
                /* Sidebar becomes a fixed full-height drawer */
                .sidebar {
                    position: fixed !important;
                    top: 0;
                    left: 0;
                    height: 100vh !important;
                    width: var(--sb-width) !important;
                    min-width: var(--sb-width) !important;
                    /* starts off-screen to the left */
                    transform: translateX(-100%);
                    transition: transform .35s var(--ease);
                    z-index: 350 !important; /* below header (400), above overlay (300) */
                }

                    .sidebar.sb-open {
                        transform: translateX(0);
                    }
                /* Overlay shown on mobile */
                .sb-overlay {
                    display: block
                }
                /* Main area fills viewport width (sidebar is now fixed, not in flow) */
                .main-area {
                    width: 100%;
                    flex: 1
                }

                .sb-brand {
                    min-height: 96px;
                    padding: 15px 12px 11px;
                }

                .sb-brand-logo {
                    max-width: 162px;
                    max-height: 76px;
                }
                /* Header padding tighter */
                .app-header {
                    padding: 0 10px 0 8px
                }
                /* Toggle always visible */
                .hd-toggle {
                    display: flex !important;
                    flex-shrink: 0 !important
                }
                /* User button → circle-only on mobile */
                .hd-user-name,
                .hd-user-role,
                .hd-caret {
                    display: none !important
                }

                .hd-user-btn {
                    padding: 3px !important;
                    border-radius: 50% !important;
                    gap: 0 !important;
                }
                /* Dropdown position on mobile */
                .user-dd-menu {
                    right: 8px;
                    min-width: 200px
                }
                /* Page content scrolls normally */
                .page-content {
                    padding: 16px 14px 32px;
                    /* On mobile allow -webkit-overflow-scrolling for smooth inertia */
                    -webkit-overflow-scrolling: touch;
                }

                .stat-grid {
                    grid-template-columns: 1fr 1fr
                }

                .page-heading {
                    font-size: 1.2rem
                }
            }

            /* ── Small phones (≤480px) ── */
            @@media (max-width:480px) {
                .stat-grid {
                    grid-template-columns: 1fr
                }

                .search-input, .search-input:focus {
                    width: 100%
                }

                .app-header {
                    padding: 0 8px
                }

                .hd-page-title {
                    font-size: .8rem
                }
            }

            /* ── Very narrow portrait (≤360px) ── */
            @@media (max-width:360px) {
                .hd-page-title {
                    display: none
                }

                .app-header {
                    padding: 0 6px
                }
            }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    @if (isLoggedIn)
    {
        <!-- Mobile overlay backdrop -->
        <div class="sb-overlay" id="sbOverlay"></div>

        <div class="app-shell">

            <!-- ███████████  SIDEBAR  ███████████ -->
            <aside class="sidebar" id="appSidebar">

                <a class="sb-brand" href="#" aria-label="Tâm Trí">
                    <div class="sb-brand-logo-wrap">
                        <img class="sb-brand-logo" src="data:image/png;base64," alt="Logo Tâm Trí" />
                    </div>
                </a>

                <div class="sb-divider"></div>

                <nav class="sb-nav">

                    @if (role == "Admin")
                    {
                        <a class="sb-link" href="/Admin/Dashboard">
                            <i class="fas fa-gauge-high"></i><span>Dashboard</span>
                        </a>
                        <div class="sb-section">Người Dùng</div>
                        <a class="sb-link" href="/Admin/Users">
                            <i class="fas fa-users"></i><span>Người dùng</span>
                        </a>
                        <div class="sb-section">Lớp Học</div>
                        <a class="sb-link" href="/Admin/Classes">
                            <i class="fas fa-chalkboard"></i><span>Lớp học</span>
                        </a>
                        <a class="sb-link" href="/Admin/Rooms">
                            <i class="fas fa-door-open"></i><span>Phòng học</span>
                        </a>
                        <div class="sb-section">Lịch Học</div>
                        <a class="sb-link" href="/Admin/Schedules">
                            <i class="fas fa-calendar-alt"></i><span>Lịch học</span>
                        </a>
                        <a class="sb-link" href="/Admin/Sessions">
                            <i class="fas fa-clock"></i><span>Buổi học</span>
                        </a>
                        <a class="sb-link" href="/Admin/Holidays">
                            <i class="fas fa-umbrella-beach"></i><span>Ngày nghỉ lễ</span>
                        </a>
                        <div class="sb-section">Điểm Danh</div>
                        <a class="sb-link" href="/Admin/Attendance">
                            <i class="fas fa-clipboard-check"></i><span>Điểm danh</span>
                        </a>
                        <div class="sb-section">Báo Cáo</div>
                        <a class="sb-link" href="/Admin/Reports">
                            <i class="fas fa-chart-bar"></i><span>Thống kê</span>
                        </a>
                    }

                    @if (role == "Teacher")
                    {
                        <a class="sb-link" href="/Teacher/Schedule">
                            <i class="fas fa-calendar-alt"></i><span>Lịch dạy</span>
                        </a>
                        <a class="sb-link" href="/Teacher/Attendance">
                            <i class="fas fa-clipboard-check"></i><span>Điểm danh</span>
                        </a>
                        <a class="sb-link" href="/Teacher/Statistics">
                            <i class="fas fa-chart-line"></i><span>Thống kê</span>
                        </a>
                    }

                    @if (role == "Student" || role == "Parent")
                    {
                        <a class="sb-link" href="/Student/Schedule">
                            <i class="fas fa-calendar-alt"></i><span>Lịch học</span>
                        </a>
                        <a class="sb-link" href="/Student/Attendance">
                            <i class="fas fa-chart-pie"></i><span>Chuyên cần</span>
                        </a>
                    }

                </nav>
                <!-- No sidebar footer — removed as requested -->

            </aside>
            <!-- ███████████  /SIDEBAR  ███████████ -->
            <!-- ███████████  MAIN  ███████████ -->
            <div class="main-area">

                <!-- HEADER -->
                <header class="app-header">

                    <!-- Left: toggle + page title -->
                    <div class="hd-left">
                        <button class="hd-toggle" id="sidebarToggle" title="Ẩn/hiện menu">
                            <i class="fas fa-bars"></i>
                        </button>
                        <span class="hd-page-title">@ViewData["Title"]</span>
                    </div>

                    <!-- Right: user dropdown only (bell removed) -->
                    <div class="hd-right">

                        <!-- USER BUTTON — toggles .user-dd-menu via JS -->
                        <button class="hd-user-btn"
                                id="userBtn"
                                type="button"
                                aria-expanded="false"
                                aria-haspopup="true">
                            <div class="hd-avatar">@avatarLetter</div>
                            <div class="d-none d-sm-flex flex-column" style="line-height:1.25;text-align:right">
                                <span class="hd-user-name">@fullname</span>
                                <span class="hd-user-role">@role</span>
                            </div>
                            <i class="fas fa-chevron-down hd-caret d-none d-sm-block"></i>
                        </button>

                        <!-- Dropdown — position:fixed, top = header height, always below header -->
                        <ul class="user-dd-menu" id="userMenu" role="menu">
                            <li>
                                <div class="dd-user-card">
                                    <div class="dd-avatar-lg">@avatarLetter</div>
                                    <div style="overflow:hidden">
                                        <div class="dd-name">@fullname</div>
                                        <div class="dd-role">@role</div>
                                    </div>
                                </div>
                            </li>
                            <li>
                                <a class="dd-item" href="/Account/Profile">
                                    <i class="fas fa-user-circle"></i> Hồ sơ cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dd-item" href="/Account/ChangePassword">
                                    <i class="fas fa-key"></i> Đổi mật khẩu
                                </a>
                            </li>
                            <li><div class="dd-divider"></div></li>
                            <li>
                                <a class="dd-item dd-logout" href="/Account/Logout">
                                    <i class="fas fa-right-from-bracket"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>

                    </div>
                </header>
                <!-- /HEADER -->
                <!-- PAGE CONTENT -->
                <main class="page-content">
                    <div class="container-fluid p-0">
                        @RenderBody()
                    </div>
                </main>

            </div>
            <!-- ███████████  /MAIN  ███████████ -->

        </div>

        <!-- /.app-shell -->
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
        const sidebar   = document.getElementById('appSidebar');
        const overlay   = document.getElementById('sbOverlay');
        const toggleBtn = document.getElementById('sidebarToggle');
        const userBtn   = document.getElementById('userBtn');
        const userMenu  = document.getElementById('userMenu');

        /* ── Detect mobile ── */
        const isMobile = () => window.innerWidth <= 768;

        /* ── SIDEBAR OPEN / CLOSE helpers ── */
        function openSidebar() {
        sidebar.classList.add('sb-open');
        overlay.classList.add('active');
        }
        function closeSidebar() {
        sidebar.classList.remove('sb-open');
        overlay.classList.remove('active');
        }

        /* ── SIDEBAR TOGGLE ── */
        if (toggleBtn && sidebar) {
        toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (isMobile()) {
        sidebar.classList.contains('sb-open') ? closeSidebar() : openSidebar();
        } else {
        sidebar.classList.toggle('sb-hidden');
        }
        });
        }

        /* Close sidebar when tapping overlay */
        if (overlay) {
        overlay.addEventListener('click', closeSidebar);
        overlay.addEventListener('touchend', function(e) {
        e.preventDefault();
        closeSidebar();
        });
        }

        /* Reset on resize to desktop */
        window.addEventListener('resize', function() {
        if (!isMobile()) {
        closeSidebar();
        }
        });

        /* ── USER DROPDOWN ──
        position:fixed keeps it below header regardless of overflow ancestors.
        We handle click AND touchend so it works on mobile.                   */
        if (userBtn && userMenu) {

        function openMenu() {
        userMenu.classList.add('show');
        userBtn.setAttribute('aria-expanded', 'true');
        }
        function closeMenu() {
        userMenu.classList.remove('show');
        userBtn.setAttribute('aria-expanded', 'false');
        }
        function toggleMenu() {
        userMenu.classList.contains('show') ? closeMenu() : openMenu();
        }

        /* click works for mouse; touchend for touch devices */
        userBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        toggleMenu();
        });

        /* Close when tapping/clicking anywhere outside */
        document.addEventListener('click', function(e) {
        if (!userBtn.contains(e.target) && !userMenu.contains(e.target)) {
        closeMenu();
        }
        });
        document.addEventListener('touchend', function(e) {
        if (!userBtn.contains(e.target) && !userMenu.contains(e.target)) {
        closeMenu();
        }
        }, {passive:true});

        /* Close on Escape */
        document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeMenu();
        });
        }

        /* ── AUTO-ACTIVE NAV LINK ── */
        document.querySelectorAll('.sb-link').forEach(function(link) {
        const path = window.location.pathname.toLowerCase();
        const href = (link.getAttribute('href') || '').toLowerCase();
        if (href && href !== '/' && path.startsWith(href)) {
        link.classList.add('active');
        }
        });

        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
