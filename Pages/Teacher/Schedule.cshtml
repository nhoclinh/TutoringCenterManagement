@* ── TABLE VIEW ── *@
<div id="tableView" style="display:none">
    <div class="table-card">
        <div class="table-card-hd">
            <div class="table-card-title">
                <div class="ct-icon"><i class="fas fa-calendar-alt"></i></div>
                Danh sách buổi dạy
            </div>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <div class="status-summary" style="padding:0;border:none;background:none">
                    <span class="ss-item"><span class="ss-dot" style="background:#3b82f6"></span>@Model.ScheduledSessions lịch</span>
                    <span class="ss-sep"></span>
                    <span class="ss-item"><span class="ss-dot" style="background:#6d28d9"></span>@Model.CompletedSessions xong</span>
                    <span class="ss-sep"></span>
                    <span class="ss-item"><span class="ss-dot" style="background:#9ca3af"></span>@Model.CancelledSessions huỷ</span>
                </div>
                <span style="font-size:.75rem;color:var(--text-3);font-weight:500">
                    Tổng: <strong style="color:var(--text-1)">@totalSess buổi</strong>
                </span>
            </div>
        </div>
        <div style="overflow-x:auto">
            <table class="sessions-table">
                <colgroup>
                    <col class="col-date">
                    <col class="col-class">
                    <col class="col-subj">
                    <col class="col-shift">
                    <col class="col-room">
                    <col class="col-role">
                    <col class="col-status">
                    <col class="col-act">
                </colgroup>
                <thead>
                    <tr>
                        <th>Ngày</th>
                        <th>Lớp</th>
                        <th class="col-subj">Môn</th>
                        <th>Ca học</th>
                        <th>Phòng</th>
                        <th class="col-role">Vai trò</th>
                        <th>Trạng thái</th>
                        <th style="text-align:right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="sessTableBody">
                    @if (Model.Sessions.Any())
                    {
                        @foreach (var s in Model.Sessions)
                        {
                            var sc = StatusCls(s.Status);
                            var dow = DowVi(s.SessionDate.DayOfWeek);
                            var col = SubjectColor(s.Subject);
                            var isToday = s.SessionDate == today;
                            var sn = s.ClassCode.Replace("'", "\\'");
                            var sd = s.SessionDate.ToString("dd/MM/yyyy");
                            var ssh = s.ShiftName.Replace("'", "\\'");
                            var sst = s.ShiftTime.Replace("'", "\\'");
                            var sr = s.RoomCode.Replace("'", "\\'");
                            var ste = s.TeacherName.Replace("'", "\\'");
                            var sas = (s.AssistantName ?? "").Replace("'", "\\'");
                            <tr class="@(isToday ? "today-row" : "")"
                                onclick="openModal(@s.SessionId,'@sn','@sd','@dow','@ssh','@sst','@sr','@ste','@sas','@sc',@(s.IsMainTeacher ? "true" : "false"),@(s.HasAttendance ? "true" : "false"),'@s.Note')">
                                <td>
                                    <div class="date-day">
                                        @s.SessionDate.ToString("dd/MM/yyyy")
                                        @if (isToday)
                                        {
                                            <span class="date-today-dot" title="Hôm nay"></span>
                                        }
                                    </div>
                                    <div class="date-dow">@dow</div>
                                </td>
                                <td><span class="class-pill"><i class="fas fa-chalkboard" style="font-size:10px"></i> @s.ClassCode</span></td>
                                <td class="col-subj"><span class="subj-pill" style="background:@col">@s.SubjectLabel</span></td>
                                <td style="color:var(--text-2)">
                                    @s.ShiftName
                                    <span style="color:var(--text-3);font-size:.75rem;display:block">@s.ShiftTime</span>
                                </td>
                                <td><span class="room-pill"><i class="fas fa-door-open" style="font-size:10px"></i> @s.RoomCode</span></td>
                                <td class="col-role">
                                    @if (s.IsMainTeacher)
                                    {
                                        <span class="role-pill main"><i class="fas fa-star" style="font-size:9px"></i> Chính</span>
                                    }
                                    else
                                    {
                                        <span class="role-pill assist"><i class="fas fa-user-gear" style="font-size:9px"></i> Trợ giảng</span>
                                    }
                                </td>
                                <td>
                                    <span class="sess-badge @sc">
                                        @if (s.Status == SessionStatus.Scheduled)
                                        {
                                            <i class="fas fa-calendar-check"></i>
                                            <text> Đã lên lịch</text>
        }
                                        else if (s.Status == SessionStatus.Ongoing)
                                        {
                                            <i class="fas fa-circle-dot"></i>
                                            <text> Đang diễn ra</text>
        }
                                        else if (s.Status == SessionStatus.Completed)
                                        {
                                            <i class="fas fa-check-circle"></i>
                                            <text> Hoàn thành</text>
        }
                                        else
                                        {
                                            <i class="fas fa-ban"></i>
                                            <text> Đã hủy</text>
        }
                                    </span>
                                </td>
                                <td onclick="event.stopPropagation()">
                                    <div style="display:flex;justify-content:flex-end;gap:5px">
                                        <a href="@s.AttendanceUrl" class="act-btn attend"
                                           title="@(s.HasAttendance ? "Xem điểm danh" : "Điểm danh")">
                                            <i class="fas fa-clipboard-check"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="empty-row">
                            <td colspan="8">
                                <div class="empty-icon"><i class="fas fa-calendar-xmark"></i></div>
                                <div class="empty-title">Không có buổi học nào</div>
                                <div class="empty-desc">Thử thay đổi bộ lọc hoặc kiểm tra lại lịch</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Sessions.Any())
        {
            <div class="table-foot">
                <span class="foot-info">Hiển thị <strong id="footShowing">@totalSess</strong> / @totalSess buổi</span>
            </div>
        }
    </div>
</div>

