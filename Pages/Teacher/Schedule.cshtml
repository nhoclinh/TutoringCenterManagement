        <div class="tp-val">@Model.ThisWeekSessions buổi</div>
    </div>
    <div class="today-panel-sep"></div>
    <div class="today-panel-text">
        <div class="tp-date">Tháng này</div>
        <div class="tp-val">@Model.ThisMonthSessions buổi</div>
    </div>
    <div class="today-sess-count">
        <span class="today-sess-bubble">
            <i class="fas fa-calendar-day"></i>
