@* ── Filter card ── *@
<div class="filter-card">
    <form method="get" id="filterForm">
        <div class="filter-grid">
            <div>
                <label>Lớp học</label>
                <select name="ClassFilter" class="filter-select">
                    <option value="">Tất cả lớp của tôi</option>
                    @foreach (var c in Model.MyClasses)
                    {
                        var sel = Model.ClassFilter == c.ClassId.ToString();
                        <option value="@c.ClassId" selected="@sel">@c.ClassCode</option>
                    }
                </select>
            </div>
            <div>
                <label>Trạng thái</label>
                <select name="StatusFilter" class="filter-select">
                    <option value="">Tất cả</option>
                    <option value="0" selected="@(Model.StatusFilter == "0")">Đã lên lịch</option>
                    <option value="1" selected="@(Model.StatusFilter == "1")">Đang diễn ra</option>
                    <option value="2" selected="@(Model.StatusFilter == "2")">Hoàn thành</option>
                    <option value="3" selected="@(Model.StatusFilter == "3")">Đã hủy</option>
                </select>
            </div>
            <div>
                <label>Từ ngày</label>
                <input type="date" name="FromDate" class="filter-date" value="@Model.FromDate" />
            </div>
            <div>
                <label>Đến ngày</label>
                <input type="date" name="ToDate" class="filter-date" value="@Model.ToDate" />
            </div>
            <div class="filter-btn-group">
                <button type="submit" class="btn-brand" style="height:36px;padding:0 16px;font-size:.82rem;white-space:nowrap">
                    <i class="fas fa-search"></i> Lọc
                </button>
                <a href="/Teacher/Schedule" class="btn-outline" style="height:36px;padding:0 12px;font-size:.82rem;display:inline-flex;align-items:center" title="Đặt lại">
                    <i class="fas fa-rotate-left"></i>
                </a>
            </div>
        </div>
    </form>
</div>

@* ── Content topbar ── *@
<div class="content-topbar">
    <div class="topbar-left">
        <div class="pagesize-wrap" id="pagesizeWrap">
            <span>Hiển thị</span>
            <select class="pagesize-select" id="pagesizeSelect">
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="100" selected>100</option>
                <option value="0">Tất cả</option>
            </select>
