@page
@model TutoringCenterManagement.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

@section Styles {
    <style>
        /* ══════════════════════════════════════════════
           CHANGE PASSWORD — đồng bộ design system
        ══════════════════════════════════════════════ */
        .profile-layout {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 20px;
            align-items: start;
        }

        /* Sidebar (dùng lại từ Profile) */
        .sidebar-card {
            background: var(--bg-card);
            border-radius: var(--r-lg);
            border: 1px solid var(--border);
            box-shadow: var(--sh-sm);
            overflow: hidden;
            position: sticky;
            top: 20px;
        }

        .sidebar-hd {
            padding: 14px 18px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(to right, #fafbff, #fff);
            font-size: .78rem;
            font-weight: 700;
            color: var(--text-2);
            display: flex;
            align-items: center;
            gap: 7px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

            .sidebar-hd i {
                color: var(--c-primary);
            }

        .sidebar-body {
            padding: 24px 18px;
        }

        .profile-avatar-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            color: #fff;
            font-size: 28px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 20px rgba(0,0,0,.15);
        }

            .profile-avatar.admin {
                background: linear-gradient(135deg,#f43f5e,#fb7185);
                box-shadow: 0 6px 20px rgba(244,63,94,.3);
            }

            .profile-avatar.teacher {
                background: linear-gradient(135deg,#3b82f6,#60a5fa);
                box-shadow: 0 6px 20px rgba(59,130,246,.3);
            }

            .profile-avatar.student {
                background: linear-gradient(135deg,#10b981,#34d399);
                box-shadow: 0 6px 20px rgba(16,185,129,.3);
            }

            .profile-avatar.parent {
                background: linear-gradient(135deg,#f59f00,#fbbf24);
                box-shadow: 0 6px 20px rgba(245,159,0,.3);
            }

        .profile-name {
            font-size: 1rem;
            font-weight: 800;
            color: var(--text-1);
            text-align: center;
        }

        .profile-username {
            font-size: .78rem;
            color: var(--text-3);
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: .72rem;
            font-weight: 700;
            border: 1px solid transparent;
        }

            .role-badge.admin {
                background: #fff1f2;
                color: #e03131;
                border-color: #fecdd3;
            }

            .role-badge.teacher {
                background: #eff6ff;
                color: #2563eb;
                border-color: #bfdbfe;
            }

            .role-badge.student {
                background: #ecfdf5;
                color: #059669;
                border-color: #a7f3d0;
            }

            .role-badge.parent {
                background: #fffbeb;
                color: #d97706;
                border-color: #fde68a;
            }

        .pf-divider {
            height: 1px;
            background: var(--border);
            margin: 16px 0;
        }

        .quick-links {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .quick-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 12px;
            border-radius: var(--r-sm);
            font-size: .82rem;
            font-weight: 600;
            color: var(--text-2);
            text-decoration: none;
            transition: all .14s;
            border: 1px solid transparent;
        }

            .quick-link:hover {
                background: var(--bg-page);
                border-color: var(--border);
                color: var(--c-primary);
            }

            .quick-link.active-link {
                background: rgba(232,89,12,.06);
                border-color: rgba(232,89,12,.15);
                color: var(--c-primary);
                font-weight: 700;
            }

            .quick-link i {
                width: 18px;
                text-align: center;
                font-size: 13px;
                flex-shrink: 0;
            }

        /* ── Form card ── */
        .form-card {
            background: var(--bg-card);
            border-radius: var(--r-lg);
            border: 1px solid var(--border);
            box-shadow: var(--sh-sm);
            overflow: hidden;
        }

        .form-card-hd {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(to right, #fafbff, #fff);
        }

        .form-card-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: rgba(232,89,12,.1);
            color: var(--c-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            flex-shrink: 0;
        }

        .form-card-title {
            font-size: .92rem;
            font-weight: 700;
            color: var(--text-1);
        }

        .form-card-subtitle {
            font-size: .74rem;
            color: var(--text-3);
            margin-top: 1px;
        }

        .form-card-body {
            padding: 24px;
        }

        /* ── Password field ── */
        .form-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 20px;
        }

            .form-field:last-child {
                margin-bottom: 0;
            }

        .field-label {
            font-size: .72rem;
            font-weight: 700;
            color: var(--text-2);
            text-transform: uppercase;
            letter-spacing: .5px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .field-label .req {
                color: #f43f5e;
                font-size: 13px;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap .input-icon {
                position: absolute;
                left: 11px;
                top: 0;
                bottom: 0;
                display: flex;
                align-items: center;
                color: var(--text-3);
                font-size: 13px;
                pointer-events: none;
                transition: color .15s;
            }

            .input-wrap:focus-within .input-icon {
                color: var(--c-primary);
            }

        .pw-toggle {
            position: absolute;
            right: 10px;
            top: 0;
            bottom: 0;
            display: flex;
            align-items: center;
            color: var(--text-3);
            font-size: 13px;
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
            transition: color .15s;
        }

            .pw-toggle:hover {
                color: var(--c-primary);
            }

        .form-input {
            height: 42px;
            padding: 0 40px 0 38px;
            border: 1.5px solid var(--border);
            border-radius: var(--r-sm);
            background: #f8f9fc;
            color: var(--text-1);
            font-size: .88rem;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            font-weight: 500;
            outline: none;
            width: 100%;
            box-sizing: border-box;
            transition: border-color .15s, background .15s, box-shadow .15s;
        }

            .form-input:focus {
                border-color: var(--c-primary);
                background: #fff;
                box-shadow: 0 0 0 3px var(--c-glow);
            }

            .form-input:hover {
                border-color: #c4c9d8;
            }

            .form-input::placeholder {
                color: var(--text-3);
                font-size: .82rem;
            }

        /* Strength bar */
        .pw-strength-wrap {
            margin-top: 8px;
        }

        .pw-strength-bar {
            height: 4px;
            border-radius: 2px;
            background: var(--border);
            overflow: hidden;
            margin-bottom: 5px;
        }

        .pw-strength-fill {
            height: 100%;
            border-radius: 2px;
            width: 0;
            transition: width .3s ease, background .3s;
        }

        .pw-strength-label {
            font-size: .72rem;
            color: var(--text-3);
            font-weight: 600;
        }

        /* Requirements checklist */
        .pw-reqs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            margin-top: 10px;
            padding: 12px 14px;
            background: var(--bg-page);
            border: 1px solid var(--border);
            border-radius: var(--r-sm);
        }

        .pw-req {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: .75rem;
            color: var(--text-3);
            font-weight: 500;
            transition: color .15s;
        }

            .pw-req i {
                font-size: 10px;
                width: 14px;
                text-align: center;
            }

            .pw-req.pass {
                color: #059669;
            }

                .pw-req.pass i {
                    color: #10b981;
                }

        .field-error {
            font-size: .73rem;
            color: #e03131;
            display: none;
            align-items: center;
            gap: 4px;
        }

            .field-error:not(:empty) {
                display: flex;
            }

            .field-error::before {
                content: '\f06a';
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                font-size: 10px;
                flex-shrink: 0;
            }

        /* Info box */
        .info-box {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 14px;
            background: rgba(59,130,246,.05);
            border: 1px solid rgba(59,130,246,.2);
            border-radius: var(--r-sm);
            font-size: .8rem;
            color: var(--text-2);
            line-height: 1.5;
            margin-bottom: 20px;
        }

            .info-box i {
                color: #3b82f6;
                margin-top: 2px;
                flex-shrink: 0;
            }

        /* Form actions */
        .form-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            padding: 16px 24px;
            border-top: 1px solid var(--border);
            background: #f9fafd;
        }

        /* Toast */
        .toast-wrap {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .toast-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: var(--r-md);
            background: #fff;
            border: 1px solid var(--border);
            box-shadow: 0 8px 24px rgba(0,0,0,.12);
            font-size: .83rem;
            font-weight: 600;
            color: var(--text-1);
            min-width: 260px;
            max-width: 360px;
            animation: toastIn .3s cubic-bezier(.34,1.4,.64,1);
        }

            .toast-item.success {
                border-left: 4px solid #10b981;
            }

            .toast-item.error {
                border-left: 4px solid #f43f5e;
            }

            .toast-item.success .ti {
                color: #10b981;
            }

            .toast-item.error .ti {
                color: #f43f5e;
            }

        .toast-close {
            margin-left: auto;
            background: none;
            border: none;
            color: var(--text-3);
            cursor: pointer;
            font-size: 12px;
            padding: 0 2px;
        }

        @@keyframes toastIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@media (max-width: 900px) {
            .profile-layout {
                grid-template-columns: 1fr;
            }

            .sidebar-card {
                position: static;
            }
        }

        @@media (max-width: 600px) {
            .pw-reqs {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Toast -->
<div class="toast-wrap" id="toastWrap"></div>

<!-- HEADER -->
<div class="page-header">
    <div>
        <h1 class="page-heading">Đổi <span>mật khẩu</span></h1>
        <p class="page-subheading">
            <i class="fas fa-circle-info" style="color:var(--c-primary)"></i>
            Cập nhật mật khẩu để bảo mật tài khoản của bạn
        </p>
    </div>
</div>

<div class="profile-layout">

    <!-- ══════ SIDEBAR ══════ -->
    <div>
        <div class="sidebar-card">
            <div class="sidebar-hd">
                <i class="fas fa-id-card"></i> Tổng quan
            </div>
            <div class="sidebar-body">
                <div class="profile-avatar-wrap">
                    <div class="profile-avatar @Model.RoleCss">@Model.Initials</div>
                    <div class="profile-name">@Model.Fullname</div>
                    <div class="profile-username">@@@Model.Username</div>
                    <span class="role-badge @Model.RoleCss">
                        <i class="fas fa-shield-halved"></i> @Model.RoleLabel
                    </span>
                </div>

                <div class="pf-divider"></div>

                <div class="quick-links">
                    <a href="/Account/Profile" class="quick-link">
                        <i class="fas fa-user-pen"></i> Chỉnh sửa thông tin
                    </a>
                    <a href="/Account/ChangePassword" class="quick-link active-link">
                        <i class="fas fa-lock"></i> Đổi mật khẩu
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════ FORM ══════ -->
    <div>
        <div class="form-card">
            <div class="form-card-hd">
                <div class="form-card-icon"><i class="fas fa-lock"></i></div>
                <div>
                    <div class="form-card-title">Đổi mật khẩu</div>
                    <div class="form-card-subtitle">Nhập mật khẩu hiện tại và mật khẩu mới để cập nhật</div>
                </div>
            </div>
            <div class="form-card-body">

                <div class="info-box">
                    <i class="fas fa-circle-info"></i>
                    <span>Mật khẩu nên có ít nhất <strong>6 ký tự</strong>, kết hợp chữ hoa, chữ thường và số để đảm bảo an toàn.</span>
                </div>

                <form method="post" id="changePwForm">
                    @Html.AntiForgeryToken()

                    <!-- Mật khẩu hiện tại -->
                    <div class="form-field">
                        <label class="field-label" for="currentPw">
                            Mật khẩu hiện tại <span class="req">*</span>
                        </label>
                        <div class="input-wrap">
                            <span class="input-icon"><i class="fas fa-lock"></i></span>
                            <input asp-for="Input.CurrentPassword"
                                   type="password" id="currentPw" class="form-input"
                                   placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" />
                            <button type="button" class="pw-toggle" onclick="togglePw('currentPw', this)" tabindex="-1">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="form-field">
                        <label class="field-label" for="newPw">
                            Mật khẩu mới <span class="req">*</span>
                        </label>
                        <div class="input-wrap">
                            <span class="input-icon"><i class="fas fa-key"></i></span>
                            <input asp-for="Input.NewPassword"
                                   type="password" id="newPw" class="form-input"
                                   placeholder="Nhập mật khẩu mới" autocomplete="new-password"
                                   oninput="checkStrength(this.value); checkMatch()" />
                            <button type="button" class="pw-toggle" onclick="togglePw('newPw', this)" tabindex="-1">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="field-error"></span>

                        <!-- Strength bar -->
                        <div class="pw-strength-wrap" id="strengthWrap" style="display:none">
                            <div class="pw-strength-bar">
                                <div class="pw-strength-fill" id="strengthFill"></div>
                            </div>
                            <div class="pw-strength-label" id="strengthLabel"></div>
                        </div>

                        <!-- Requirements -->
                        <div class="pw-reqs" id="pwReqs" style="display:none">
                            <div class="pw-req" id="reqLen">
                                <i class="fas fa-circle"></i> Ít nhất 6 ký tự
                            </div>
                            <div class="pw-req" id="reqUpper">
                                <i class="fas fa-circle"></i> Chữ hoa (A-Z)
                            </div>
                            <div class="pw-req" id="reqLower">
                                <i class="fas fa-circle"></i> Chữ thường (a-z)
                            </div>
                            <div class="pw-req" id="reqNum">
                                <i class="fas fa-circle"></i> Chữ số (0-9)
                            </div>
                        </div>
                    </div>

                    <!-- Xác nhận mật khẩu -->
                    <div class="form-field">
                        <label class="field-label" for="confirmPw">
                            Xác nhận mật khẩu mới <span class="req">*</span>
                        </label>
                        <div class="input-wrap">
                            <span class="input-icon"><i class="fas fa-check-double"></i></span>
                            <input asp-for="Input.ConfirmPassword"
                                   type="password" id="confirmPw" class="form-input"
                                   placeholder="Nhập lại mật khẩu mới" autocomplete="new-password"
                                   oninput="checkMatch()" />
                            <button type="button" class="pw-toggle" onclick="togglePw('confirmPw', this)" tabindex="-1">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                        <div id="matchMsg" style="font-size:.73rem;display:none;align-items:center;gap:4px"></div>
                    </div>

                </form>
            </div>

            <div class="form-actions">
                <a href="/Account/Profile" class="btn-outline" style="padding:9px 18px;font-size:.84rem">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
                <button type="submit" form="changePwForm" class="btn-brand" style="padding:9px 24px;font-size:.84rem">
                    <i class="fas fa-lock"></i> Đổi mật khẩu
                </button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {

            /* ── Toast ── */
            function showToast(msg, type) {
                var wrap = document.getElementById('toastWrap');
                var t = document.createElement('div');
                t.className = 'toast-item ' + (type || 'success');
                t.innerHTML =
                    '<i class="fas ' + (type === 'error' ? 'fa-circle-xmark' : 'fa-circle-check') + ' ti"></i>' +
                    '<span>' + msg + '</span>' +
                    '<button class="toast-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>';
                wrap.appendChild(t);
                setTimeout(function () { if (t.parentElement) t.remove(); }, 4500);
            }

            @if (TempData["SuccessMessage"] != null)
            {
                    <text>document.addEventListener('DOMContentLoaded', function() {
                        showToast('@Html.Raw(TempData["SuccessMessage"]!.ToString()!.Replace("'", "\\'"))', 'success');
                    });</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                    <text>document.addEventListener('DOMContentLoaded', function() {
                        showToast('@Html.Raw(TempData["ErrorMessage"]!.ToString()!.Replace("'", "\\'"))', 'error');
                    });</text>
            }

            /* ── Toggle password visibility ── */
            window.togglePw = function (inputId, btn) {
                var inp = document.getElementById(inputId);
                var icon = btn.querySelector('i');
                if (inp.type === 'password') {
                    inp.type = 'text';
                    icon.className = 'fas fa-eye-slash';
                } else {
                    inp.type = 'password';
                    icon.className = 'fas fa-eye';
                }
            };

            /* ── Password strength ── */
            var strengthColors = ['#f43f5e', '#f59f00', '#10b981', '#059669'];
            var strengthLabels = ['Yếu', 'Trung bình', 'Khá mạnh', 'Mạnh'];

            window.checkStrength = function (val) {
                var wrap  = document.getElementById('strengthWrap');
                var fill  = document.getElementById('strengthFill');
                var label = document.getElementById('strengthLabel');
                var reqs  = document.getElementById('pwReqs');

                if (!val) {
                    wrap.style.display = 'none';
                    reqs.style.display = 'none';
                    return;
                }

                wrap.style.display = 'block';
                reqs.style.display = 'grid';

                var score = 0;
                var hasLen   = val.length >= 6;
                var hasUpper = /[A-Z]/.test(val);
                var hasLower = /[a-z]/.test(val);
                var hasNum   = /[0-9]/.test(val);
                var hasSym   = /[^A-Za-z0-9]/.test(val);

                if (hasLen)   score++;
                if (hasUpper) score++;
                if (hasLower) score++;
                if (hasNum)   score++;
                if (hasSym)   score++;

                var level = Math.min(Math.floor(score / 5 * 4), 3);
                var pct   = ((score / 5) * 100) + '%';

                fill.style.width      = pct;
                fill.style.background = strengthColors[level];
                label.textContent     = 'Độ mạnh: ' + strengthLabels[level];
                label.style.color     = strengthColors[level];

                // req checks
                function setReq(id, pass) {
                    var el = document.getElementById(id);
                    el.classList.toggle('pass', pass);
                    el.querySelector('i').className = pass ? 'fas fa-circle-check' : 'fas fa-circle';
                }
                setReq('reqLen',   hasLen);
                setReq('reqUpper', hasUpper);
                setReq('reqLower', hasLower);
                setReq('reqNum',   hasNum);
            };

            /* ── Match check ── */
            window.checkMatch = function () {
                var nv  = document.getElementById('newPw').value;
                var cv  = document.getElementById('confirmPw').value;
                var msg = document.getElementById('matchMsg');

                if (!cv) { msg.style.display = 'none'; return; }

                msg.style.display = 'flex';
                if (nv === cv) {
                    msg.style.color = '#059669';
                    msg.innerHTML   = '<i class="fas fa-circle-check" style="font-size:10px"></i> Mật khẩu khớp';
                } else {
                    msg.style.color = '#e03131';
                    msg.innerHTML   = '<i class="fas fa-circle-exclamation" style="font-size:10px"></i> Mật khẩu không khớp';
                }
            };

        }());
    </script>
}
