@page
@model TutoringCenterManagement.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập | TÂM TRÍ</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        /* ═══════════════════════════════════
                   TOKENS  — đồng bộ với _Layout
                ═══════════════════════════════════ */
        :root {
            --c-primary: #e8590c;
            --c-secondary: #f59f00;
            --c-gradient: linear-gradient(135deg, #e8590c 0%, #f59f00 100%);
            --c-glow: rgba(232, 89, 12, .22);
            --sb-bg: #0f1117;
            --bg-page: #eef1f8;
            --bg-card: #ffffff;
            --text-1: #181b27;
            --text-2: #5a6277;
            --text-3: #9aa0b4;
            --border: #e4e8f2;
            --r-sm: 8px;
            --r-md: 12px;
            --r-lg: 16px;
            --r-xl: 24px;
            --sh-md: 0 4px 20px rgba(0,0,0,.09), 0 2px 8px rgba(0,0,0,.04);
            --sh-lg: 0 20px 60px rgba(0,0,0,.14), 0 6px 20px rgba(0,0,0,.07);
            --ease: cubic-bezier(.4, 0, .2, 1);
        }

        /* ═══════════════════════════════════
                   BASE
                ═══════════════════════════════════ */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            font-size: 14px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            background: var(--bg-page);
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
            background-color: var(--bg-page);
            background-image: radial-gradient(ellipse at 15% 20%, rgba(232,89,12,.08) 0%, transparent 55%), radial-gradient(ellipse at 85% 80%, rgba(245,159,0,.07) 0%, transparent 55%), radial-gradient(ellipse at 80% 10%, rgba(59,130,246,.05) 0%, transparent 50%);
        }

        /* ═══════════════════════════════════
                   CARD SHELL
                ═══════════════════════════════════ */
        .login-shell {
            display: flex;
            width: 100%;
            max-width: 820px;
            min-height: 500px;
            border-radius: var(--r-xl);
            overflow: hidden;
            box-shadow: var(--sh-lg);
            animation: cardIn .45s var(--ease) both;
        }

        @@keyframes cardIn {
            from { opacity: 0; transform: translateY(18px) scale(.98); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ═══════════════════════════════════
                   LEFT PANEL  — dark brand side
                ═══════════════════════════════════ */
        .brand-panel {
            flex: 1;
            background: var(--sb-bg);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 36px;
            position: relative;
            overflow: hidden;
        }

        .brand-panel::before {
            content: '';
            position: absolute;
            width: 320px; height: 320px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(232,89,12,.18) 0%, transparent 70%);
            top: -80px; left: -80px;
            pointer-events: none;
        }

        .brand-panel::after {
            content: '';
            position: absolute;
            width: 240px; height: 240px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(245,159,0,.14) 0%, transparent 70%);
            bottom: -60px; right: -60px;
            pointer-events: none;
        }

        /* Logo image */
        .brand-logo-img {
            width: 200px;
            height: auto;
            position: relative; z-index: 1;
            /* drop-shadow thay vì box-shadow để ôm đúng hình logo trong suốt */
            filter: drop-shadow(0 8px 24px rgba(232,89,12,.35));
            animation: iconPop .55s .15s var(--ease) both;
        }

        @@keyframes iconPop {
            from { transform: scale(.82); opacity: 0; }
            to   { transform: scale(1);  opacity: 1; }
        }

        /* Divider dưới logo */
        .brand-divider {
            width: 56px; height: 3px;
            background: var(--c-gradient);
            border-radius: 2px;
            margin: 24px 0 20px;
            position: relative; z-index: 1;
        }

        /* Feature bullets */
        .brand-features {
            list-style: none;
            position: relative; z-index: 1;
            width: 100%;
        }

        .brand-features li {
            display: flex; align-items: center; gap: 10px;
            font-size: .78rem;
            color: rgba(255,255,255,.5);
            padding: 5px 0;
        }

        .brand-features li i {
            width: 20px; height: 20px;
            border-radius: 6px;
            background: rgba(232,89,12,.18);
            color: var(--c-secondary);
            display: flex; align-items: center; justify-content: center;
            font-size: 10px; flex-shrink: 0;
        }

        /* ═══════════════════════════════════
                   RIGHT PANEL — form side
                ═══════════════════════════════════ */
        .form-panel {
            flex: 1;
            background: var(--bg-card);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 48px 44px;
        }

        .form-heading {
            font-size: 1.55rem; font-weight: 800;
            color: var(--text-1); letter-spacing: -.5px;
            margin-bottom: 4px;
        }

        .form-subheading {
            font-size: .8rem;
            color: var(--text-3);
            margin-bottom: 28px;
        }

        /* ── Error alert ── */
        .login-error {
            display: flex; align-items: center; gap: 10px;
            padding: 11px 14px;
            background: #fff5f5;
            border: 1px solid #ffc9c9;
            border-left: 3px solid #fa5252;
            border-radius: var(--r-md);
            font-size: .82rem;
            color: #c92a2a;
            margin-bottom: 20px;
            animation: shakeIn .35s var(--ease);
        }

        @@keyframes shakeIn {
            0%   { transform: translateX(0); }
            20%  { transform: translateX(-6px); }
            40%  { transform: translateX(5px); }
            60%  { transform: translateX(-4px); }
            80%  { transform: translateX(3px); }
            100% { transform: translateX(0); }
        }

        /* ── Field label ── */
        .field-label {
            display: block;
            font-size: .78rem; font-weight: 600;
            color: var(--text-2);
            margin-bottom: 6px; margin-top: 16px;
            letter-spacing: .2px;
        }

        /* ── Input wrapper ── */
        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 13px; top: 50%; transform: translateY(-50%);
            color: var(--text-3); font-size: 13px;
            pointer-events: none;
        }

        .login-input {
            width: 100%; height: 42px;
            padding: 0 14px 0 36px;
            border: 1.5px solid var(--border);
            border-radius: var(--r-md);
            font-size: .88rem;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            color: var(--text-1);
            background: #fafbfd;
            transition: border-color .18s, box-shadow .18s, background .18s;
            outline: none;
        }

        .login-input:focus {
            border-color: var(--c-primary);
            box-shadow: 0 0 0 3px rgba(232,89,12,.12);
            background: #fff;
        }

        .login-input.has-eye { padding-right: 40px; }

        /* ── Eye toggle ── */
        .btn-eye {
            position: absolute;
            right: 10px; top: 50%; transform: translateY(-50%);
            background: none; border: none; cursor: pointer;
            color: var(--text-3); font-size: 13px; padding: 4px;
            transition: color .15s;
        }

        .btn-eye:hover { color: var(--c-primary); }

        /* ── Remember me ── */
        .remember-row {
            display: flex; align-items: center; gap: 8px;
            margin-top: 16px; margin-bottom: 22px;
            font-size: .8rem; color: var(--text-2);
        }

        .remember-row input[type="checkbox"] {
            width: 15px; height: 15px;
            accent-color: var(--c-primary);
            cursor: pointer;
        }

        /* ── Submit button ── */
        .btn-login {
            width: 100%; height: 44px;
            background: var(--c-gradient);
            color: #fff; font-weight: 700;
            border-radius: var(--r-md);
            font-size: .88rem;
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            letter-spacing: .3px;
            border: none; cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            box-shadow: 0 4px 14px var(--c-glow);
            transition: filter .15s, box-shadow .15s, transform .15s;
        }

        .btn-login:hover {
            filter: brightness(1.08);
            box-shadow: 0 6px 22px rgba(232,89,12,.35);
            transform: translateY(-1px);
        }

        .btn-login:active {
            transform: translateY(0);
            filter: brightness(.97);
        }



        /* ═══════════════════════════════════
                   RESPONSIVE  — stack on mobile
                ═══════════════════════════════════ */
        @@media (max-width: 640px) {
            body { padding: 16px; align-items: flex-start; padding-top: 32px; }

            .login-shell {
                flex-direction: column;
                max-width: 420px; min-height: unset;
                margin: 0 auto;
            }

            .brand-panel {
                padding: 32px 28px 28px;
                flex-direction: row; align-items: center;
                gap: 16px; justify-content: flex-start;
            }

            .brand-panel::before, .brand-panel::after { display: none; }

            .brand-logo-img {
                width: 110px;
                flex-shrink: 0;
            }

            .brand-divider, .brand-features { display: none; }

            .form-panel { width: 100%; padding: 32px 28px; }
        }
    </style>
</head>
<body>

    <div class="login-shell">

        <!-- ══════ LEFT — Brand panel ══════ -->
        <div class="brand-panel">

            <!-- Logo thật — đặt file vào wwwroot/images/logo-tamtri.png -->
            <img src="~/images/logo-tamtri.png"
                 alt="Logo Tâm Trí"
                 class="brand-logo-img" />

            <div class="brand-divider"></div>

            <ul class="brand-features">
                <li><i class="fas fa-calendar-alt"></i> Quản lý lịch học & buổi học</li>
                <li><i class="fas fa-clipboard-check"></i> Điểm danh học sinh theo buổi</li>
                <li><i class="fas fa-chart-bar"></i> Thống kê & báo cáo chuyên cần</li>
                <li><i class="fas fa-users"></i> Quản lý giáo viên & học sinh</li>
            </ul>
        </div>

        <!-- ══════ RIGHT — Form panel ══════ -->
        <div class="form-panel">

            <h2 class="form-heading">Chào mừng trở lại</h2>
            <p class="form-subheading">Đăng nhập để tiếp tục quản lý hệ thống</p>

            @* ✅ Dùng ViewData["LoginError"] — khớp với key trong .cs *@
            @if (ViewData["LoginError"] != null)
            {
                <div class="login-error">
                    <i class="fas fa-circle-exclamation"></i>
                    @ViewData["LoginError"]
                </div>
            }

            <form method="post" autocomplete="off">

                <!-- Username -->
                <div>
                    <label asp-for="Input.Username" class="field-label">Tên đăng nhập</label>
                    <div class="input-wrap">
                        <i class="fas fa-user input-icon"></i>
                        <input asp-for="Input.Username"
                               class="login-input"
                               placeholder="Nhập tên đăng nhập"
                               autocomplete="username" />
                    </div>
                    <span asp-validation-for="Input.Username" class="text-danger" style="font-size:.75rem"></span>
                </div>

                <!-- Password -->
                <div>
                    <label asp-for="Input.Password" class="field-label">Mật khẩu</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="Input.Password"
                               id="pwdInput"
                               class="login-input has-eye"
                               placeholder="Nhập mật khẩu"
                               type="password"
                               autocomplete="current-password" />
                        <button type="button" class="btn-eye" onclick="togglePassword()" title="Hiện/ẩn mật khẩu">
                            <i id="eyeIcon" class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger" style="font-size:.75rem"></span>
                </div>

                <!-- Remember me -->
                <div class="remember-row">
                    <input asp-for="Input.RememberMe" id="rememberMe" type="checkbox" />
                    <label asp-for="Input.RememberMe" for="rememberMe">Ghi nhớ đăng nhập</label>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-login">
                    <i class="fas fa-right-to-bracket"></i> ĐĂNG NHẬP
                </button>

            </form>


        </div><!-- /.form-panel -->

    </div><!-- /.login-shell -->

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function togglePassword() {
            var input = document.getElementById('pwdInput');
            var icon  = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>
</body>
</html>
