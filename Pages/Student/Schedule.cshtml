            <div class="cm-row">
                <div class="cm-row-icon" style="background:rgba(139,92,246,.1);color:#8b5cf6"><i class="fas fa-clock"></i></div>
                <div>
                    <div class="cm-row-label">Ca học</div>
                    <div class="cm-row-val" id="cm-shift">—</div>
                </div>
            </div>
            <div class="cm-row">
                <div class="cm-row-icon" style="background:rgba(6,182,212,.1);color:#06b6d4"><i class="fas fa-door-open"></i></div>
                <div>
                    <div class="cm-row-label">Phòng học</div>
                    <div class="cm-row-val" id="cm-room">—</div>
                </div>
            </div>
            <div class="cm-row">
                <div class="cm-row-icon" style="background:rgba(16,185,129,.1);color:#10b981"><i class="fas fa-user-tie"></i></div>
                <div>
                    <div class="cm-row-label">Giáo viên</div>
                    <div class="cm-row-val" id="cm-teacher">—</div>
                </div>
            </div>
            <div class="cm-row">
                <div class="cm-row-icon" style="background:rgba(245,159,0,.1);color:#f59f00"><i class="fas fa-tag"></i></div>
                <div>
                    <div class="cm-row-label">Trạng thái buổi học</div>
                    <div class="cm-row-val" id="cm-status">—</div>
                </div>
            </div>
            <div class="cm-row">
                <div class="cm-row-icon" style="background:rgba(16,185,129,.1);color:#059669"><i class="fas fa-clipboard-check"></i></div>
