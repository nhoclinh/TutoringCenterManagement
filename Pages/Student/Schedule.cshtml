@section Scripts {
<link href="~/lib/fullcalendar/index.global.min.css" rel="stylesheet" />
<script src="~/lib/fullcalendar/index.global.min.js"></script>
<script>
(function () {
    var calInit = false;
    var fcCal   = null;

    /* ── View switch ── */
    var calEl  = document.getElementById('calendarView');
    var tblEl  = document.getElementById('tableView');
    var btnCal = document.getElementById('btnCalView');
    var btnTbl = document.getElementById('btnTableView');
    var psWrap = document.getElementById('pagesizeWrap');

    window.switchView = function (v) {
        if (v === 'calendar') {
            tblEl.style.display = 'none';
            calEl.style.display = 'block';
            btnCal.classList.add('active'); btnTbl.classList.remove('active');
            psWrap.style.display = 'none';
            if (!calInit) initCalendar();
        } else {
            calEl.style.display = 'none';
            tblEl.style.display = 'block';
            btnTbl.classList.add('active'); btnCal.classList.remove('active');
            psWrap.style.display = 'flex';
            applyPageSize();
        }
    };

    /* ── Page size ── */
    var allRows = [];
    document.addEventListener('DOMContentLoaded', function () {
        var tbody = document.getElementById('sessTableBody');
        if (tbody) allRows = Array.from(tbody.querySelectorAll('tr[onclick]'));

        psWrap.style.display = 'none';

        var sel = document.getElementById('pagesizeSelect');
        if (sel) sel.addEventListener('change', applyPageSize);

        initCalendar();
    });

    function applyPageSize() {
        var sel   = document.getElementById('pagesizeSelect');
        var limit = sel ? parseInt(sel.value) : 100;
        var shown = 0;
        allRows.forEach(function (r, i) {
            if (limit === 0 || i < limit) { r.classList.remove('row-hidden'); shown++; }
            else r.classList.add('row-hidden');
        });
        var fsh = document.getElementById('footShowing');
        if (fsh) fsh.textContent = shown;
        var sl  = document.getElementById('showingLabel');
        if (sl)  sl.textContent = shown + ' buổi học';
    }

    /* ── Modal ── */
    var statusLabels = {
        'scheduled': '<span class="sess-badge scheduled"><i class="fas fa-calendar-check"></i> Đã lên lịch</span>',
        'ongoing':   '<span class="sess-badge ongoing"><i class="fas fa-circle-dot"></i> Đang diễn ra</span>',
        'completed': '<span class="sess-badge completed"><i class="fas fa-check-circle"></i> Hoàn thành</span>',
        'cancelled': '<span class="sess-badge cancelled"><i class="fas fa-ban"></i> Đã hủy</span>'
    };
    var attLabels = {
        'present':      '<span class="att-badge present"><i class="fas fa-check"></i> Có mặt</span>',
        'absent':       '<span class="att-badge absent"><i class="fas fa-times"></i> Vắng mặt</span>',
        'not-recorded': '<span class="att-badge not-recorded"><i class="fas fa-minus"></i> Chưa ghi nhận</span>'
    };

    window.openModal = function (sid, cls, clsFull, date, dow, shift, shiftTime, room, roomName, teacher, assistant, statusCls, attCls, attLbl, subject, note) {
        document.getElementById('cm-title').textContent    = clsFull || cls;
        document.getElementById('cm-subtitle').textContent = date + ' · ' + dow + ' · ' + subject;
        document.getElementById('cm-class').textContent    = clsFull + (cls !== clsFull ? ' (' + cls + ')' : '');
        document.getElementById('cm-date').textContent     = date + ' (' + dow + ')';
        document.getElementById('cm-shift').textContent    = shift + '  ' + shiftTime;
        document.getElementById('cm-room').textContent     = room + (roomName ? ' — ' + roomName : '');

        var teacherText = teacher;
        if (assistant) teacherText += ' · Trợ giảng: ' + assistant;
        document.getElementById('cm-teacher').textContent = teacherText;

        document.getElementById('cm-status').innerHTML = statusLabels[statusCls] || statusCls;
        document.getElementById('cm-att').innerHTML    = attLabels[attCls]       || attLbl;

        var noteRow = document.getElementById('cm-note-row');
        if (note && note.trim()) {
            document.getElementById('cm-note').textContent = note;
            noteRow.style.display = 'flex';
        } else {
            noteRow.style.display = 'none';
        }

        document.getElementById('cmBackdrop').classList.add('cm-open');
        document.getElementById('cmModal').classList.add('cm-open');
    };

    function closeModal() {
        document.getElementById('cmBackdrop').classList.remove('cm-open');
        document.getElementById('cmModal').classList.remove('cm-open');
    }
    document.getElementById('cmClose').addEventListener('click', closeModal);
    document.getElementById('cmClose2').addEventListener('click', closeModal);
    document.getElementById('cmBackdrop').addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

    /* ── FullCalendar ── */
    function initCalendar() {
        if (calInit) return;
        calInit = true;

        var classFilter    = document.querySelector('[name="ClassFilter"]')?.value ?? '';
        var statusFilter   = document.querySelector('[name="StatusFilter"]')?.value ?? '';
        var studentFilter  = document.querySelector('[name="StudentIdFilter"]')?.value ?? '';

        fcCal = new FullCalendar.Calendar(document.getElementById('scheduleCalendar'), {
            initialView: 'dayGridMonth',
            locale: 'vi',
            headerToolbar: {
                left:   'prev,next today',
                center: 'title',
                right:  'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: function (fetchInfo, successCb, failureCb) {
                var url = '/Student/Schedule?handler=GetEvents'
                    + '&start=' + fetchInfo.startStr
                    + '&end='   + fetchInfo.endStr;
                if (classFilter)   url += '&classFilter='   + encodeURIComponent(classFilter);
                if (statusFilter)  url += '&statusFilter='  + encodeURIComponent(statusFilter);
                if (studentFilter) url += '&studentIdFilter=' + encodeURIComponent(studentFilter);
                fetch(url).then(function (r) { return r.json(); }).then(successCb).catch(failureCb);
            },
            eventClick: function (info) {
                var p = info.event.extendedProps;
                openModal(
                    p.sessionId, p.className, p.classFullName,
                    p.date, p.dow, p.shift, p.shiftTime,
                    p.room, p.roomName, p.teacher, '',
                    p.statusCls, p.attCls, '', '', p.note
                );
            },
            eventClassNames: function (arg) {
                var p = arg.event.extendedProps;
                // Nếu đã completed + có attendance: hiển thị màu attendance
                if (p.statusCls === 'completed' && p.attCls !== 'not-recorded') {
                    return ['fc-event-att-' + p.attCls];
                }
                return ['fc-event-' + p.statusCls];
            },
            dayMaxEvents: 4,
            height: 'auto'
        });
        fcCal.render();
    }
})();
</script>
}
