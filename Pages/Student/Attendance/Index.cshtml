            height: 28px;
            border-radius: 7px;
            background: rgba(232,89,12,.1);
            color: var(--c-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .card-title {
            font-size: .88rem;
            font-weight: 700;
            color: var(--text-1);
        }

        .card-sub {
            font-size: .68rem;
            color: var(--text-3);
            margin-top: 1px;
        }

        .card-body {
            padding: 16px 20px;
        }

        .chart-lgd {
            display: flex;
            gap: 12px;
        }

        .lgd-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: .71rem;
            font-weight: 600;
            color: var(--text-2);
        }

        .lgd-dot {
            width: 10px;
            height: 10px;
            border-radius: 2px;
        }

        /* ── Table card ─────────────────────────────────────────────── */
        .tbl-card {
            background: var(--bg-card);
            border-radius: var(--r-lg);
            border: 1px solid var(--border);
            box-shadow: var(--sh-sm);
            overflow: hidden;
        }

        .tbl-hd {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 13px 20px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(to right,#fafbff,#fff);
            flex-wrap: wrap;
        }

        .tbl-hd-l {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: .9rem;
            font-weight: 700;
            color: var(--text-1);
        }

        .tbl-count {
            font-size: .74rem;
            color: var(--text-3);
            font-weight: 500;
        }

            .tbl-count strong {
                color: var(--text-1);
            }

        .att-tbl {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

            .att-tbl thead th {
                padding: 9px 13px;
                font-size: .67rem;
                font-weight: 700;
                color: var(--text-2);
                text-transform: uppercase;
                letter-spacing: .6px;
                background: #f4f6fc;
                border-bottom: 2px solid var(--border);
                white-space: nowrap;
            }

                .att-tbl thead th:first-child {
