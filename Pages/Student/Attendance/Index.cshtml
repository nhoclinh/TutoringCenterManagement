                    background: rgba(16,185,129,.055);
                }

                .att-tbl tbody tr.ra:hover td {
                    background: rgba(244,63,94,.045);
                }

        .d-main {
            font-size: .83rem;
            font-weight: 800;
            color: var(--text-1);
        }

        .d-sub {
            font-size: .67rem;
            font-weight: 600;
            color: var(--text-3);
            margin-top: 1px;
        }

        .today-dot {
            display: inline-block;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--c-primary);
            margin-left: 4px;
            vertical-align: middle;
        }

        .pill-cls {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(232,89,12,.08);
            color: var(--c-primary);
            font-weight: 700;
            font-size: .75rem;
            padding: 2px 8px;
            border-radius: 20px;
        }

        .pill-room {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(59,130,246,.08);
            color: #1d4ed8;
            font-weight: 700;
            font-size: .75rem;
            padding: 2px 8px;
            border-radius: 20px;
        }

        .pill-std {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(139,92,246,.08);
            color: #7c3aed;
            font-weight: 700;
            font-size: .73rem;
            padding: 2px 7px;
            border-radius: 6px;
            border: 1px solid rgba(139,92,246,.2);
        }

        .att-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 11px;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 700;
        }

            .att-badge.p {
                background: #ecfdf5;
                color: #059669;
                border: 1px solid #a7f3d0;
            }

            .att-badge.a {
                background: #fff1f2;
                color: #e03131;
                border: 1px solid #fecdd3;
            }

        .tcell-name {
            font-size: .8rem;
            font-weight: 700;
            color: var(--text-1);
        }

        .tcell-asst {
            font-size: .69rem;
            color: var(--text-3);
            margin-top: 2px;
        }

        .empty-cell {
            text-align: center;
            padding: 60px 20px !important;
            background: transparent !important;
            border: none !important;
        }

        .empty-ico {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: #f4f6fc;
            margin: 0 auto 13px;
            display: flex;
            align-items: center;
