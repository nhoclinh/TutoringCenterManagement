                }

                .att-tbl thead th:last-child {
                    padding-right: 20px;
                }

            .att-tbl tbody td {
                padding: 11px 13px;
                font-size: .82rem;
                color: var(--text-1);
                border-bottom: 1px solid #f0f2f8;
