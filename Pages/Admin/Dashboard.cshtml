<!-- ════════════════════════════════════════
     CUSTOM MODAL — vanilla JS
     Dùng position:fixed trực tiếp, KHÔNG phụ thuộc Bootstrap Modal JS
════════════════════════════════════════ -->
<div class="cm-backdrop" id="cmBackdrop"></div>
<div class="cm-modal" id="cmModal" role="dialog" aria-modal="true" aria-labelledby="cmTitle">
    <div class="cm-box">
        <div class="cm-header">
            <div class="cm-title" id="cmTitle">
                <i class="fas fa-calendar-day"></i>
                Chi tiết buổi học
            </div>
            <button class="cm-close" id="cmClose" aria-label="Đóng">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="cm-body">
            <div class="cm-row">
                <div class="cm-row-icon" style="background:rgba(232,89,12,.1);color:var(--c-primary)">
                    <i class="fas fa-chalkboard"></i>
                </div>
                <div>
                    <div class="cm-row-label">Lớp học</div>
                    <div class="cm-row-val" id="cm-class">—</div>
                </div>
            </div>
            <div class="cm-row">
                <div class="cm-row-icon" style="background:rgba(59,130,246,.1);color:#3b82f6">
                    <i class="fas fa-clock"></i>
                </div>
                <div>
                    <div class="cm-row-label">Ca học</div>
                    <div class="cm-row-val" id="cm-shift">—</div>
                </div>
            </div>
            <div class="cm-row">
                <div class="cm-row-icon" style="background:rgba(16,185,129,.1);color:#10b981">
                    <i class="fas fa-door-open"></i>
                </div>
                <div>
                    <div class="cm-row-label">Phòng học</div>
                    <div class="cm-row-val" id="cm-room">—</div>
                </div>
            </div>
        </div>
        <div class="cm-footer">
            <button class="btn-outline" id="cmClose2" style="font-size:.82rem;padding:7px 16px">
                <i class="fas fa-times"></i> Đóng
            </button>
            <a id="cm-attend-link" href="/Admin/Attendance" class="btn-brand" style="font-size:.82rem;padding:7px 18px">
                <i class="fas fa-clipboard-check"></i> Điểm danh
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <link href="~/lib/fullcalendar/index.global.min.css" rel="stylesheet" />
    <script src="~/lib/fullcalendar/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            /* ── Đưa modal ra thẳng body để thoát khỏi mọi overflow container ── */
            var backdrop = document.getElementById('cmBackdrop');
            var modal    = document.getElementById('cmModal');
            if (backdrop && backdrop.parentNode !== document.body) document.body.appendChild(backdrop);
            if (modal    && modal.parentNode    !== document.body) document.body.appendChild(modal);

            /* ── Today label ── */
            var now  = new Date();
            var days = ['Chủ nhật','Thứ hai','Thứ ba','Thứ tư','Thứ năm','Thứ sáu','Thứ bảy'];
            var el   = document.getElementById('todayLabel');
            if (el) {
                el.textContent = days[now.getDay()] + ', ' +
                    String(now.getDate()).padStart(2,'0') + '/' +
                    String(now.getMonth()+1).padStart(2,'0') + '/' +
                    now.getFullYear();
            }

            /* ── Custom modal open/close ── */
            function openModal(cls, shift, room, sessionId) {
                document.getElementById('cm-class').textContent = cls   || '—';
                document.getElementById('cm-shift').textContent = shift || '—';
                document.getElementById('cm-room').textContent  = room  || '—';
                var link = document.getElementById('cm-attend-link');
                if (link) link.href = sessionId ? '/Admin/Attendance?sessionId=' + sessionId : '/Admin/Attendance';
                backdrop.classList.add('cm-open');
                modal.classList.add('cm-open');
            }

            function closeModal() {
                backdrop.classList.remove('cm-open');
                modal.classList.remove('cm-open');
            }

            document.getElementById('cmClose').addEventListener('click',  closeModal);
            document.getElementById('cmClose2').addEventListener('click', closeModal);
            backdrop.addEventListener('click', closeModal);
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closeModal();
            });

            /* ── FullCalendar ── */
            var calendarEl = document.getElementById('calendar');
            if (calendarEl) {
                var calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    locale: 'vi',
                    headerToolbar: {
                        left:   'prev,next today',
                        center: 'title',
                        right:  'dayGridMonth,timeGridWeek,timeGridDay'
                    },
                    events:    '/Admin/Dashboard?handler=GetEvents',
                    eventClick: function (info) {
                        openModal(
                            info.event.title,
                            info.event.extendedProps.shift,
                            info.event.extendedProps.room,
                            info.event.extendedProps.sessionId
                        );
                    },
                    eventColor:   '#e8590c',
                    dayMaxEvents: 3,
                    height:       'auto'
                });
                calendar.render();
            }

            /* ── Chart defaults ── */
            Chart.defaults.font.family = "'Plus Jakarta Sans', system-ui, sans-serif";
            Chart.defaults.font.size   = 12;
            Chart.defaults.color       = '#5a6277';

            /* ── Attendance bar chart ── */
            var attCtx = document.getElementById('attendanceChart');
            if (attCtx) {
                new Chart(attCtx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Model.Last7Days),
                        datasets: [
                            {
                                label: 'Có mặt',
                                data:  @Html.Raw(Model.AttendancePresentData),
                                backgroundColor: '#10b981',
                                borderRadius: 5, borderSkipped: false
                            },
                            {
                                label: 'Vắng mặt',
                                data:  @Html.Raw(Model.AttendanceAbsentData),
                                backgroundColor: '#f43f5e',
                                borderRadius: 5, borderSkipped: false
                            }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { position:'top', labels:{ padding:16, usePointStyle:true, pointStyleWidth:8 } },
                            tooltip: { backgroundColor:'#181b27', padding:10, cornerRadius:8, titleFont:{ weight:'700' } }
                        },
                        scales: {
                            x: { grid:{ display:false }, border:{ display:false }, ticks:{ font:{ size:11 } } },
                            y: { beginAtZero:true, grid:{ color:'#f0f2f8' }, border:{ display:false }, ticks:{ font:{ size:11 }, stepSize:1 } }
                        }
                    }
                });
            }

            /* ── Class doughnut chart ── */
            var clsCtx = document.getElementById('classChart');
            if (clsCtx) {
                new Chart(clsCtx, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(Model.ClassNames),
                        datasets: [{
                            data: @Html.Raw(Model.ClassStudentCounts),
                            backgroundColor: ['#e8590c','#f59f00','#10b981','#3b82f6','#8b5cf6','#f43f5e'],
                            borderWidth: 0, hoverOffset: 8
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false, cutout: '68%',
                        plugins: {
                            legend: { position:'right', labels:{ padding:14, usePointStyle:true, pointStyleWidth:8, font:{ size:11 } } },
                            tooltip: { backgroundColor:'#181b27', padding:10, cornerRadius:8, titleFont:{ weight:'700' } }
                        }
                    }
                });
            }

        });
    </script>
}
