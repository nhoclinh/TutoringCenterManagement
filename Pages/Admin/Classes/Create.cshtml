@page
@model TutoringCenterManagement.Pages.Admin.Classes.CreateModel
@{
    ViewData["Title"] = "Tạo lớp học mới";

    /* Subject data */
    string[] subjectNames = { "Toán", "Tiếng Việt", "Tiếng Anh", "Vật lý", "Sinh học", "Hóa học", "Địa lý", "Lịch sử", "Khác" };
    string[] subjectIcons = { "fa-square-root-variable", "fa-book-open", "fa-language", "fa-atom", "fa-dna", "fa-flask", "fa-earth-asia", "fa-landmark", "fa-ellipsis" };
    var subjectColors = new Dictionary<string, string> {
        {"Toán",        "#3b82f6"},
        {"Tiếng Việt",  "#10b981"},
        {"Tiếng Anh",   "#f59f00"},
        {"Vật lý",      "#8b5cf6"},
        {"Sinh học",    "#06b6d4"},
        {"Hóa học",     "#ec4899"},
        {"Địa lý",      "#84cc16"},
        {"Lịch sử",     "#f97316"},
        {"Khác",        "#6b7280"}
    };
}

@section Styles {
<style>
    /* ════════════════════════════════════
       CLASSES CREATE — đồng bộ design system
    ════════════════════════════════════ */

    .create-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 20px;
        align-items: start;
    }

    /* ── Form card ── */
    .form-card {
        background: var(--bg-card);
        border-radius: var(--r-lg);
        border: 1px solid var(--border);
        box-shadow: var(--sh-sm);
        overflow: hidden;
        margin-bottom: 16px;
    }
    .form-card:last-child { margin-bottom: 0; }
    .form-card-hd {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        background: linear-gradient(to right, #fafbff, #fff);
    }
    .form-card-icon {
        width: 30px; height: 30px; border-radius: 8px;
        background: rgba(232,89,12,.1); color: var(--c-primary);
        display: flex; align-items: center; justify-content: center;
        font-size: 13px; flex-shrink: 0;
    }
    .form-card-title    { font-size: .92rem; font-weight: 700; color: var(--text-1); }
    .form-card-subtitle { font-size: .75rem; color: var(--text-3); margin-top: 1px; }
    .form-card-body     { padding: 22px 24px; }

    /* ── Field ── */
    .form-field { display: flex; flex-direction: column; gap: 6px; }
    .field-label {
        font-size: .72rem; font-weight: 700; color: var(--text-2);
        text-transform: uppercase; letter-spacing: .5px;
        display: flex; align-items: center; gap: 5px;
    }
    .field-label .req { color: #f43f5e; font-size: 13px; line-height: 1; }
    .field-label .badge-opt {
        font-size: .6rem; font-weight: 600; padding: 1px 6px;
        border-radius: 4px; background: var(--bg-page);
        border: 1px solid var(--border); color: var(--text-3);
        text-transform: none; letter-spacing: 0;
    }
    .field-hint {
        font-size: .72rem; color: var(--text-3);
        display: flex; align-items: center; gap: 4px;
    }
    .field-hint i { font-size: 10px; color: var(--c-primary); }

    /* ── Inputs ── */
    .form-input,
    .form-textarea {
        padding: 0 12px;
        border: 1.5px solid var(--border);
        border-radius: var(--r-sm);
        background: #f8f9fc; color: var(--text-1);
        font-size: .85rem;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        font-weight: 500; outline: none;
        width: 100%; box-sizing: border-box;
        transition: border-color .15s, background .15s, box-shadow .15s;
    }
    .form-input { height: 38px; }
    .form-textarea { padding: 10px 12px; min-height: 80px; resize: vertical; line-height: 1.5; }
    .form-input:focus,
    .form-textarea:focus {
        border-color: var(--c-primary); background: #fff;
        box-shadow: 0 0 0 3px var(--c-glow);
    }
    .form-input:hover:not(:focus),
    .form-textarea:hover:not(:focus) { border-color: #c4c9d8; }
    .form-input::placeholder,
    .form-textarea::placeholder { color: var(--text-3); font-size: .82rem; }

    /* Input with icon */
    .input-wrap { position: relative; }
    .input-wrap .input-icon {
        position: absolute; left: 11px; top: 0; bottom: 0;
        display: flex; align-items: center;
        color: var(--text-3); font-size: 13px;
        pointer-events: none; transition: color .15s;
    }
    .input-wrap:focus-within .input-icon { color: var(--c-primary); }
    .input-wrap .form-input { padding-left: 34px; }

    /* Two-column grid inside card */
    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    /* Validation */
    .field-error {
        font-size: .73rem; color: #e03131;
        display: none; align-items: center; gap: 4px;
    }
    .field-error:not(:empty) { display: flex; }
    .field-error::before {
        content: '\f06a';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900; font-size: 10px; flex-shrink: 0;
    }

    /* ── Subject pills ── */
    .subject-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }
    .subject-radio { display: none; }
    .subject-label {
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        padding: 12px 10px;
        border: 1.5px solid var(--border);
        border-radius: var(--r-md);
        background: var(--bg-page); cursor: pointer;
        transition: all .15s; user-select: none;
    }
    .subject-label:hover { transform: translateY(-2px); box-shadow: var(--sh-xs); }
    .subject-icon-wrap {
        width: 38px; height: 38px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px; flex-shrink: 0;
        transition: all .15s;
    }
    .subject-name {
        font-size: .78rem; font-weight: 700;
        color: var(--text-2); text-align: center;
        transition: color .15s;
    }
    .subject-radio:checked + .subject-label {
        border-width: 2px;
        background: #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }
    .subject-radio:checked + .subject-label .subject-icon-wrap {
        color: #fff !important;
    }
    .subject-radio:not(:checked) + .subject-label .subject-icon-wrap {
        background: var(--bg-subject-light) !important;
        color: var(--color-subject) !important;
    }
    .subject-radio:checked + .subject-label .subject-name {
        color: var(--text-1);
    }

    /* ── Status toggle ── */
    .status-options {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }
    .status-radio { display: none; }
    .status-label {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--r-md);
        background: var(--bg-page); cursor: pointer;
        transition: all .15s; user-select: none;
    }
    .status-label:hover { border-color: #c4c9d8; }
    .status-dot {
        width: 12px; height: 12px; border-radius: 50%;
        flex-shrink: 0; position: relative;
    }
    .status-dot.active {
        background: #10b981;
        box-shadow: 0 0 0 0 rgba(16,185,129,.4);
    }
    .status-dot.inactive { background: #9ca3af; }
    .status-text {
        font-size: .82rem; font-weight: 600;
        color: var(--text-2);
    }
    .status-radio:checked + .status-label {
        border-width: 2px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }
    .status-radio:checked + .status-label .status-dot.active {
        animation: sPulse 2.2s infinite;
    }
    .status-radio:checked + .status-label .status-text { color: var(--text-1); }
    @@keyframes sPulse {
        0%   { box-shadow: 0 0 0 0 rgba(16,185,129,.45); }
        70%  { box-shadow: 0 0 0 6px rgba(16,185,129,.0); }
        100% { box-shadow: 0 0 0 0 rgba(16,185,129,.0); }
    }

    /* ── Grade level pills ── */
    .grade-grid {
        display: flex; flex-wrap: wrap; gap: 6px;
    }
    .grade-radio { display: none; }
    .grade-label {
        min-width: 36px; height: 36px;
        display: flex; align-items: center; justify-content: center;
        border: 1.5px solid var(--border);
        border-radius: var(--r-sm);
        background: var(--bg-page); cursor: pointer;
        font-size: .82rem; font-weight: 700; color: var(--text-2);
        transition: all .15s; user-select: none;
        padding: 0 10px;
    }
    .grade-label:hover { border-color: var(--c-primary); color: var(--c-primary); background: rgba(232,89,12,.05); }
    .grade-radio:checked + .grade-label {
        background: var(--c-primary); border-color: var(--c-primary);
        color: #fff;
        box-shadow: 0 2px 8px rgba(232,89,12,.3);
    }

    /* ── Preview sidebar ── */
    .preview-card {
        background: var(--bg-card);
        border-radius: var(--r-lg);
        border: 1px solid var(--border);
        box-shadow: var(--sh-sm);
        overflow: hidden;
        position: sticky; top: 80px;
    }
    .preview-hd {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        background: linear-gradient(to right, #fafbff, #fff);
        font-size: .78rem; font-weight: 700; color: var(--text-2);
        display: flex; align-items: center; gap: 7px;
        text-transform: uppercase; letter-spacing: .5px;
    }
    .preview-hd i { color: var(--c-primary); }
    .preview-body { padding: 20px 18px; }

    /* Class preview card */
    .pv-class-card {
        border-radius: var(--r-md);
        border: 1.5px solid var(--border);
        overflow: hidden; margin-bottom: 16px;
        transition: border-color .3s;
    }
    .pv-class-banner {
        height: 70px;
        display: flex; align-items: center; justify-content: center;
        font-size: 28px; color: #fff;
        background: linear-gradient(135deg, #9ca3af, #d1d5db);
        transition: background .3s;
        position: relative; overflow: hidden;
    }
    .pv-class-banner::before {
        content: '';
        position: absolute; inset: 0;
        background: repeating-linear-gradient(
            45deg,
            rgba(255,255,255,.04) 0, rgba(255,255,255,.04) 1px,
            transparent 0, transparent 50%
        );
        background-size: 12px 12px;
    }
    .pv-class-info { padding: 12px 14px; }
    .pv-code-badge {
        display: inline-flex; align-items: center;
        padding: 3px 10px; border-radius: 5px;
        background: var(--bg-page); border: 1px solid var(--border);
        color: var(--text-3); font-size: .72rem; font-weight: 800;
        letter-spacing: .5px; font-family: 'Courier New', monospace;
        font-style: italic;
    }
    .pv-code-badge.filled {
        background: rgba(232,89,12,.08); border-color: rgba(232,89,12,.2);
        color: var(--c-primary); font-style: normal;
    }
    .pv-subject-name {
        font-size: .88rem; font-weight: 800; color: var(--text-1);
        margin-top: 6px;
    }
    .pv-subject-name.empty { color: var(--text-3); font-style: italic; font-size: .82rem; font-weight: 400; }

    .pv-divider { height: 1px; background: var(--border); margin: 14px 0; }
    .pv-row { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 10px; }
    .pv-row:last-child { margin-bottom: 0; }
    .pv-row-icon {
        width: 22px; height: 22px; border-radius: 5px;
        background: var(--bg-page); color: var(--text-3);
        display: flex; align-items: center; justify-content: center;
        font-size: 10px; flex-shrink: 0; margin-top: 1px;
    }
    .pv-row-lbl { font-size: .68rem; color: var(--text-3); font-weight: 600; text-transform: uppercase; letter-spacing: .4px; }
    .pv-row-val { font-size: .82rem; color: var(--text-1); font-weight: 600; margin-top: 1px; line-height: 1.4; }
    .pv-row-val.empty { color: var(--text-3); font-weight: 400; font-style: italic; }

    /* ── Actions ── */
    .form-actions {
        display: flex; align-items: center; justify-content: flex-end;
        gap: 10px; padding: 16px 24px;
        border-top: 1px solid var(--border);
        background: #f9fafd;
    }

    /* ── Responsive ── */
    @@media (max-width: 900px) {
        .create-layout { grid-template-columns: 1fr; }
        .preview-card { position: static; }
    }
    @@media (max-width: 600px) {
        .subject-grid { grid-template-columns: repeat(2, 1fr); }
        .form-row-2 { grid-template-columns: 1fr; }
    }
</style>
}

<!-- ════════════════════════════════════════
     PAGE HEADER
════════════════════════════════════════ -->
<div class="page-header">
    <div>
        <h1 class="page-heading">Tạo <span>lớp học mới</span></h1>
        <p class="page-subheading">
            <i class="fas fa-circle-info" style="color:var(--c-primary)"></i>
            Nhập thông tin để tạo lớp học mới trong hệ thống
        </p>
    </div>
    <div class="page-actions">
        <a href="/Admin/Classes" class="btn-outline">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<!-- ════════════════════════════════════════
     MAIN LAYOUT
════════════════════════════════════════ -->
<div class="create-layout">

    <!-- ── Cột trái: Form ── -->
    <div>
        <form method="post" id="createForm">

            <!-- ┌──────────────────────────────────────┐ -->
            <!-- │  CARD 1 — Thông tin cơ bản           │ -->
            <!-- └──────────────────────────────────────┘ -->
            <div class="form-card">
                <div class="form-card-hd">
                    <div class="form-card-icon"><i class="fas fa-chalkboard"></i></div>
                    <div>
                        <div class="form-card-title">Thông tin lớp học</div>
                        <div class="form-card-subtitle">Mã lớp và môn học chính</div>
                    </div>
                </div>
                <div class="form-card-body">

                    <div class="form-field" style="margin-bottom:16px">
                        <label class="field-label" for="inputClassCode">
                            Mã lớp <span class="req">*</span>
                        </label>
                        <div class="input-wrap">
                            <span class="input-icon"><i class="fas fa-hashtag"></i></span>
                            <input asp-for="Input.ClassCode"
                                   id="inputClassCode"
                                   class="form-input"
                                   placeholder="VD: TOAN-10A, ANH-8B..."
                                   autocomplete="off"
                                   style="text-transform:uppercase;letter-spacing:.5px;font-family:'Courier New',monospace;font-weight:700" />
                        </div>
                        <span asp-validation-for="Input.ClassCode" class="field-error"></span>
                        <span class="field-hint">
                            <i class="fas fa-circle-info"></i>
                            Mã lớp phải duy nhất và sẽ tự động chuyển thành chữ hoa
                        </span>
                    </div>

                    <div class="form-field">
                        <label class="field-label">
                            Môn học <span class="req">*</span>
                        </label>
                        <div class="subject-grid">
                            @for (int i = 0; i <= 8; i++)
                            {
                                var subColor = subjectColors[subjectNames[i]];
                                <span>
                                    <input type="radio"
                                           asp-for="Input.Subject"
                                           value="@i"
                                           id="subj@(i)"
                                           class="subject-radio" />
                                    <label for="subj@(i)" class="subject-label">
                                        <span class="subject-icon-wrap" style="background:@subColor + "14";color:@subColor">
                                            <i class="fas @subjectIcons[i]"></i>
                                        </span>
                                        <span class="subject-name">@subjectNames[i]</span>
                                    </label>
                                </span>
                            }
                        </div>
                        <span asp-validation-for="Input.Subject" class="field-error"></span>
                    </div>

                </div>
            </div>

            <!-- ┌──────────────────────────────────────┐ -->
            <!-- │  CARD 2 — Khối & Tên lớp (MỚI)      │ -->
            <!-- └──────────────────────────────────────┘ -->
            <div class="form-card">
                <div class="form-card-hd">
                    <div class="form-card-icon"><i class="fas fa-layer-group"></i></div>
                    <div>
                        <div class="form-card-title">Khối & Tên lớp</div>
                        <div class="form-card-subtitle">Phân loại theo khối và tên lớp học sinh (tuỳ chọn)</div>
                    </div>
                </div>
                <div class="form-card-body">

                    <div class="form-field" style="margin-bottom:16px">
                        <label class="field-label">
                            Khối <span class="badge-opt">tuỳ chọn</span>
                        </label>
                        <div class="grade-grid" id="gradeGrid">
                            @* Radio "Không chọn" *@
                            <span>
                                <input type="radio" name="Input.GradeLevel" value="" id="gradeNone" class="grade-radio" checked />
                                <label for="gradeNone" class="grade-label">—</label>
                            </span>
                            @for (int g = 1; g <= 12; g++)
                            {
                                <span>
                                    <input type="radio"
                                           name="Input.GradeLevel"
                                           value="@g"
                                           id="grade@(g)"
                                           class="grade-radio" />
                                    <label for="grade@(g)" class="grade-label">@g</label>
                                </span>
                            }
                        </div>
                        <span asp-validation-for="Input.GradeLevel" class="field-error"></span>
                        <span class="field-hint">
                            <i class="fas fa-circle-info"></i>
                            Chọn khối tương ứng với học sinh trong lớp (lớp 1 → 12)
                        </span>
                    </div>

                    <div class="form-field">
                        <label class="field-label" for="inputClassName">
                            Tên lớp <span class="badge-opt">tuỳ chọn</span>
                        </label>
                        <div class="input-wrap">
                            <span class="input-icon"><i class="fas fa-id-badge"></i></span>
                            <input asp-for="Input.ClassName"
                                   id="inputClassName"
                                   class="form-input"
                                   placeholder="VD: 10A1, 11B2, 12C3..."
                                   autocomplete="off" />
                        </div>
                        <span asp-validation-for="Input.ClassName" class="field-error"></span>
                        <span class="field-hint">
                            <i class="fas fa-circle-info"></i>
                            Tên lớp học sinh đang học tại trường (để dễ phân biệt)
                        </span>
                    </div>

                </div>
            </div>

            <!-- ┌──────────────────────────────────────┐ -->
            <!-- │  CARD 3 — Trạng thái                 │ -->
            <!-- └──────────────────────────────────────┘ -->
            <div class="form-card">
                <div class="form-card-hd">
                    <div class="form-card-icon"><i class="fas fa-toggle-on"></i></div>
                    <div>
                        <div class="form-card-title">Trạng thái lớp học</div>
                        <div class="form-card-subtitle">Active: có thể tạo lịch · Inactive: không thể tạo lịch</div>
                    </div>
                </div>
                <div class="form-card-body">

                    <div class="form-field">
                        <label class="field-label">Trạng thái</label>
                        <div class="status-options">
                            <span>
                                <input type="radio"
                                       asp-for="Input.Status"
                                       value="1"
                                       id="statusActive"
                                       class="status-radio"
                                       checked />
                                <label for="statusActive" class="status-label">
                                    <span class="status-dot active"></span>
                                    <span class="status-text">Đang hoạt động</span>
                                </label>
                            </span>
                            <span>
                                <input type="radio"
                                       asp-for="Input.Status"
                                       value="0"
                                       id="statusInactive"
                                       class="status-radio" />
                                <label for="statusInactive" class="status-label">
                                    <span class="status-dot inactive"></span>
                                    <span class="status-text">Ngừng hoạt động</span>
                                </label>
                            </span>
                        </div>
                        <span class="field-hint" style="margin-top:8px">
                            <i class="fas fa-lightbulb"></i>
                            Chỉ lớp <strong>Active</strong> mới xuất hiện khi tạo lịch học và buổi học
                        </span>
                    </div>

                </div>
            </div>

            <!-- ┌──────────────────────────────────────┐ -->
            <!-- │  CARD 4 — Mô tả                      │ -->
            <!-- └──────────────────────────────────────┘ -->
            <div class="form-card">
                <div class="form-card-hd">
                    <div class="form-card-icon"><i class="fas fa-align-left"></i></div>
                    <div>
                        <div class="form-card-title">Mô tả lớp học</div>
                        <div class="form-card-subtitle">Thông tin bổ sung (không bắt buộc)</div>
                    </div>
                </div>
                <div class="form-card-body">
                    <div class="form-field">
                        <label class="field-label">
                            Nội dung mô tả
                            <span class="badge-opt">tuỳ chọn</span>
                        </label>
                        <textarea asp-for="Input.Description"
                                  id="inputDescription"
                                  class="form-textarea"
                                  placeholder="VD: Lớp học nâng cao cho học sinh giỏi, ôn thi HSG..."></textarea>
                    </div>
                </div>
            </div>

            <!-- ── Action buttons ── -->
            <div class="form-card">
                <div class="form-actions">
                    <a href="/Admin/Classes" class="btn-outline">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                    <button type="submit" class="btn-brand">
                        <i class="fas fa-plus"></i> Tạo lớp học
                    </button>
                </div>
            </div>

        </form>
    </div>

    <!-- ── Cột phải: Preview sidebar ── -->
    <div>
        <div class="preview-card">
            <div class="preview-hd">
                <i class="fas fa-eye"></i> Xem trước
            </div>
            <div class="preview-body">

                <!-- Class card preview -->
                <div class="pv-class-card">
                    <div class="pv-class-banner" id="pvBanner">
                        <i class="fas fa-chalkboard"></i>
                    </div>
                    <div class="pv-class-info">
                        <div>
                            <span class="pv-code-badge" id="pvCode">Chưa có mã</span>
                        </div>
                        <div class="pv-subject-name empty" id="pvSubject">Chưa chọn môn học</div>
                    </div>
                </div>

                <div class="pv-divider"></div>

                <div class="pv-row">
                    <div class="pv-row-icon"><i class="fas fa-layer-group"></i></div>
                    <div>
                        <div class="pv-row-lbl">Khối / Tên lớp</div>
                        <div class="pv-row-val empty" id="pvGrade">Chưa chọn</div>
                    </div>
                </div>

                <div class="pv-row">
                    <div class="pv-row-icon"><i class="fas fa-circle"></i></div>
                    <div>
                        <div class="pv-row-lbl">Trạng thái</div>
                        <div class="pv-row-val" id="pvStatus">Đang hoạt động</div>
                    </div>
                </div>

                <div class="pv-row">
                    <div class="pv-row-icon"><i class="fas fa-align-left"></i></div>
                    <div>
                        <div class="pv-row-lbl">Mô tả</div>
                        <div class="pv-row-val empty" id="pvDesc">Chưa có mô tả</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
<script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
(function () {

    /* Subject colors map */
    var subjectData = @Html.Raw(Json.Serialize(new {
        colors = subjectColors,
        names = subjectNames
    }));

    /* Preview refs */
    var pvBanner  = document.getElementById('pvBanner');
    var pvCode    = document.getElementById('pvCode');
    var pvSubject = document.getElementById('pvSubject');
    var pvGrade   = document.getElementById('pvGrade');
    var pvStatus  = document.getElementById('pvStatus');
    var pvDesc    = document.getElementById('pvDesc');

    /* ══════════════════════════════════════
       UPDATE PREVIEW
    ══════════════════════════════════════ */
    function updatePreview() {
        /* Class Code */
        var code = document.getElementById('inputClassCode').value.trim().toUpperCase();
        if (code) {
            pvCode.textContent = code;
            pvCode.className   = 'pv-code-badge filled';
        } else {
            pvCode.textContent = 'Chưa có mã';
            pvCode.className   = 'pv-code-badge';
        }

        /* Subject */
        var selectedSubj = document.querySelector('input[name="Input.Subject"]:checked');

        document.querySelectorAll('.subject-label').forEach(function(label) {
            var icon = label.querySelector('.subject-icon-wrap');
            var labelFor = label.getAttribute('for');
            var radio = document.getElementById(labelFor);
            var idx = parseInt(radio.value);
            var name = subjectData.names[idx];
            var color = subjectData.colors[name];
            icon.style.background = color + '14';
            icon.style.color = color;
        });

        if (selectedSubj) {
            var idx = parseInt(selectedSubj.value);
            var name = subjectData.names[idx];
            var color = subjectData.colors[name];
            pvSubject.textContent = name;
            pvSubject.className   = 'pv-subject-name';
            pvBanner.style.background = 'linear-gradient(135deg,' + color + ',' + color + 'cc)';
            var checkedLabel = document.querySelector('input[name="Input.Subject"]:checked + .subject-label');
            if (checkedLabel) {
                var checkedIcon = checkedLabel.querySelector('.subject-icon-wrap');
                checkedIcon.style.background = color;
                checkedIcon.style.color = '#fff';
            }
        } else {
            pvSubject.textContent = 'Chưa chọn môn học';
            pvSubject.className   = 'pv-subject-name empty';
            pvBanner.style.background = 'linear-gradient(135deg, #9ca3af, #d1d5db)';
        }

        /* Grade + ClassName */
        var selectedGrade = document.querySelector('input[name="Input.GradeLevel"]:checked');
        var className = document.getElementById('inputClassName').value.trim();
        var gradeVal = selectedGrade ? selectedGrade.value : '';
        var gradeParts = [];
        if (gradeVal) gradeParts.push('Khối ' + gradeVal);
        if (className) gradeParts.push(className);
        if (gradeParts.length > 0) {
            pvGrade.textContent = gradeParts.join(' · ');
            pvGrade.className   = 'pv-row-val';
        } else {
            pvGrade.textContent = 'Chưa chọn';
            pvGrade.className   = 'pv-row-val empty';
        }

        /* Status */
        var selectedStatus = document.querySelector('input[name="Input.Status"]:checked');
        if (selectedStatus) {
            pvStatus.textContent = selectedStatus.value === '1' ? 'Đang hoạt động' : 'Ngừng hoạt động';
        }

        /* Description */
        var desc = document.getElementById('inputDescription').value.trim();
        if (desc) {
            pvDesc.textContent = desc;
            pvDesc.className   = 'pv-row-val';
        } else {
            pvDesc.textContent = 'Chưa có mô tả';
            pvDesc.className   = 'pv-row-val empty';
        }
    }

    /* ══════════════════════════════════════
       AUTO-UPPERCASE CLASS CODE
    ══════════════════════════════════════ */
    var codeInput = document.getElementById('inputClassCode');
    if (codeInput) {
        codeInput.addEventListener('input', function () {
            var pos = this.selectionStart;
            this.value = this.value.toUpperCase();
            this.setSelectionRange(pos, pos);
            updatePreview();
        });
    }

    /* ══════════════════════════════════════
       BIND ALL INPUTS
    ══════════════════════════════════════ */
    document.querySelectorAll('.subject-radio, .status-radio, .grade-radio').forEach(function (el) {
        el.addEventListener('change', updatePreview);
    });

    var classNameInput = document.getElementById('inputClassName');
    if (classNameInput) classNameInput.addEventListener('input', updatePreview);

    var descInput = document.getElementById('inputDescription');
    if (descInput) descInput.addEventListener('input', updatePreview);

    /* Init */
    updatePreview();

})();
</script>
}
