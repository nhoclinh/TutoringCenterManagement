        span.flatpickr-weekday {
            font-weight: 700 !important;
            color: var(--text-2) !important;
            font-size: .72rem !important;
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof flatpickr !== 'undefined' && document.getElementById('sessionDate')) {
                flatpickr('#sessionDate', {
                    dateFormat: 'Y-m-d',
                    altInput: true,
                    altFormat: 'd/m/Y',
                    locale: 'vn',
                    allowInput: true,
                    disableMobile: true
                });
            }
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {

            var classSelect     = document.getElementById('classSelect');
            var sessionDate     = document.getElementById('sessionDate');
            var shiftSelect     = document.getElementById('shiftSelect');
            var roomSelect      = document.getElementById('roomSelect');
            var primaryTeacher  = document.getElementById('primaryTeacher');
            var assistantTeacher= document.getElementById('assistantTeacher');
            var noteInput       = document.getElementById('noteInput');
            var btnSubmit       = document.getElementById('btnSubmit');

            /* Preview elements */
            var prevAvatar   = document.getElementById('prevAvatar');
            var prevClass    = document.getElementById('prevClass');
            var prevDate     = document.getElementById('prevDate');
            var prevShift    = document.getElementById('prevShift');
            var prevRoom     = document.getElementById('prevRoom');
            var prevPrimary  = document.getElementById('prevPrimary');
            var prevAssistant= document.getElementById('prevAssistant');

            var teacherPairCard = document.getElementById('teacherPairCard');
            var teacherPairList = document.getElementById('teacherPairList');
            var conflictWarn    = document.getElementById('conflictWarn');
            var assistantError  = document.getElementById('assistantError');

            var dow = ['CN','T2','T3','T4','T5','T6','T7'];

            /* ── Set default date = today ── */
            if (sessionDate && !sessionDate.value) {
                sessionDate.value = new Date().toISOString().split('T')[0];
            }

            /* ── Helpers ── */
            function selText(el) {
                return el && el.value ? el.options[el.selectedIndex].text : '';
            }

            function setVal(el, txt) {
                if (!el) return;
                if (txt) {
                    el.textContent = txt;
                    el.classList.remove('empty');
                } else {
                    el.textContent = el.dataset.empty || '—';
                    el.classList.add('empty');
                }
            }

            function fmtDate(val) {
                if (!val) return '';
                var d = new Date(val + 'T00:00:00');
                return dow[d.getDay()] + ' ' + d.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric' });
            }

            /* ── Update preview ── */
            function updatePreview() {
                var className = selText(classSelect);
                var date      = sessionDate ? sessionDate.value : '';
                var shift     = selText(shiftSelect);
                var room      = roomSelect && roomSelect.value
                    ? roomSelect.options[roomSelect.selectedIndex].text.split(' (')[0] : '';
                var primary   = selText(primaryTeacher);
                var assistant = assistantTeacher && assistantTeacher.value ? selText(assistantTeacher) : '';

                /* Avatar color by class */
                if (classSelect && classSelect.value) {
                    prevAvatar.style.background = 'linear-gradient(135deg,#e8590c,#f59f00)';
                }

                /* Class & date */
                prevClass.textContent = className || 'Chưa chọn lớp';
                prevClass.style.color = className ? 'var(--text-1)' : 'var(--text-3)';
                prevDate.textContent  = date ? fmtDate(date) : '—';

                /* Others */
                setVal(prevShift,     shift    || '');
                setVal(prevRoom,      room     || '');
                setVal(prevPrimary,   primary  || '');
                setVal(prevAssistant, assistant|| '');
                if (!prevAssistant.classList.contains('empty'))
                    prevAssistant.textContent = prevAssistant.textContent;
                else prevAssistant.textContent = 'Không có';

                /* Teacher pair card */
                updateTeacherPair(primary, assistant);

                /* Conflict check */
                var conflict = primary && assistant && primaryTeacher.value === assistantTeacher.value;
                conflictWarn.style.display = conflict ? 'flex' : 'none';
                if (assistantError) assistantError.style.display = conflict ? 'flex' : 'none';
                btnSubmit.disabled = conflict;
            }

            function updateTeacherPair(primary, assistant) {
                var hasPrimary   = !!primary;
                var hasAssistant = !!assistant;

                if (!hasPrimary && !hasAssistant) {
                    teacherPairCard.style.display = 'none';
                    return;
                }
                teacherPairCard.style.display = 'block';
                var html = '';
                if (hasPrimary) {
                    html += '<div class="teacher-item primary">' +
                        '<span class="teacher-badge primary">Chính</span>' +
                        '<span class="teacher-name">' + primary + '</span>' +
                        '<i class="fas fa-chalkboard-teacher" style="color:#e8590c;font-size:12px"></i>' +
                        '</div>';
                }
                if (hasAssistant) {
                    html += '<div class="teacher-item assistant">' +
                        '<span class="teacher-badge assistant">Trợ giảng</span>' +
                        '<span class="teacher-name">' + assistant + '</span>' +
                        '<i class="fas fa-user-plus" style="color:#3b82f6;font-size:12px"></i>' +
                        '</div>';
                }
                teacherPairList.innerHTML = html;
            }

            /* ── Bind events ── */
            [classSelect, sessionDate, shiftSelect, roomSelect, primaryTeacher, assistantTeacher]
                .forEach(function (el) {
                    if (el) el.addEventListener('change', updatePreview);
                });
            if (sessionDate) sessionDate.addEventListener('input', updatePreview);

            /* ── Submit validation ── */
            document.getElementById('createSessionForm').addEventListener('submit', function (e) {
                var pId = primaryTeacher ? primaryTeacher.value : '';
                var aId = assistantTeacher ? assistantTeacher.value : '';
                if (pId && aId && pId === aId) {
                    e.preventDefault();
                    assistantTeacher.classList.add('is-invalid');
                    if (assistantError) {
                        assistantError.style.display = 'flex';
                        assistantError.querySelector('i').nextSibling
                            ? null
                            : assistantError.insertAdjacentText('beforeend', ' Không được trùng giáo viên chính!');
                    }
                    conflictWarn.style.display = 'flex';
                }
            });

            /* ── Init ── */
            updatePreview();

        })();
    </script>
}
