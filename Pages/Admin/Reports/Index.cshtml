@page
@model TutoringCenterManagement.Pages.Admin.ReportsModel
@using TutoringCenterManagement.Data.Enums
@{
    ViewData["Title"] = "Thống kê & Báo cáo";
    var mn = new[] { "", "T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8", "T9", "T10", "T11", "T12" };
    var periodLabel = Model.FilterMonth == 0
        ? $"Cả năm {Model.FilterYear}"
        : $"Tháng {Model.FilterMonth}/{Model.FilterYear}";

    Func<Subject, string> subjectColor = s => s switch
    {
        Subject.Math => "#3b82f6",
        Subject.Vietnamese => "#10b981",
        Subject.English => "#f59f00",
        Subject.Physics => "#8b5cf6",
        Subject.Biology => "#06b6d4",
        Subject.Chemistry => "#ec4899",
        Subject.Geography => "#84cc16",
        Subject.History => "#f97316",
        _ => "#6b7280"
    };

    var maxMonthSess = Model.MonthlySessionStats.Any() ? Model.MonthlySessionStats.Max(m => m.Completed + m.Cancelled + m.Scheduled) : 1;
    var maxNewStudent = Model.MonthlyNewStudentStats.Any() ? Model.MonthlyNewStudentStats.Max(m => m.Count) : 1;
    var maxSubjSt = Model.SubjectStudentStats.Any() ? Model.SubjectStudentStats.Max(s => s.Count) : 1;
    var maxTeacher = Model.TeacherSessionStats.Any() ? Model.TeacherSessionStats.Max(t => t.SessionCount) : 1;
    int totalSt = Model.StudentActive + Model.StudentSuspended + Model.StudentLeft;
    int totalSess = Model.TotalSessionsCompleted + Model.TotalSessionsCancelled + Model.TotalSessionsScheduled;
    double cancelRate = totalSess > 0 ? Math.Round((double)Model.TotalSessionsCancelled / totalSess * 100, 1) : 0;

    // SVG donut helper
    double circ = 2 * Math.PI * 50;
    int dTot = totalSt > 0 ? totalSt : 1;
    double lenA = circ * Model.StudentActive / dTot;
    double lenS = circ * Model.StudentSuspended / dTot;
    double lenL = circ * Model.StudentLeft / dTot;
    double offA = 0; double offS = offA + lenA; double offL = offS + lenS;
}

